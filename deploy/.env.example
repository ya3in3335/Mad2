# Copy to deploy/.env (gitignored) and fill in. Never commit real values.
POSTGRES_PASSWORD=
# openssl rand -base64 48
AUTH_SIGNING_KEY=
# openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# One-time bootstrap of the first platform owner; remove after first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CONTROL_CENTER_ORIGIN=https://admin.example.com
# Telegram (optional). Token from @BotFather — server-side only.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=
