<UserControl x:Class="Veltrix.Desktop.Controls.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="Black" MinHeight="60">
    <!-- The video is a native surface; everything drawn over it must live inside VideoView.Content (overlay window). -->
    <vlc:VideoView x:Name="Video">
        <Grid x:Name="Overlay" Background="#01000000" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
            <Border x:Name="OfflinePanel" Background="#CC0B0F17" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="StatusGlyph" Text="&#xE714;" FontFamily="{StaticResource Font.Icons}" FontSize="26" Foreground="#99FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource cam.connecting}" Foreground="#E6FFFFFF" FontSize="13" Margin="0,6,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#99000000" CornerRadius="4" Padding="6,2" Margin="6">
                <TextBlock x:Name="NameText" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4">
                <Button x:Name="SnapshotButton" Content="&#xE722;" FontFamily="{StaticResource Font.Icons}" Style="{StaticResource Button.Icon}" Foreground="White"
                        Background="#99000000" Click="Snapshot_Click" Visibility="Collapsed" ToolTip="{DynamicResource cam.snapshot}"
                        AutomationProperties.Name="{DynamicResource cam.snapshot}"/>
                <Button x:Name="CloseButton" Content="&#xE711;" FontFamily="{StaticResource Font.Icons}" Style="{StaticResource Button.Icon}" Foreground="White"
                        Background="#99000000" Click="Close_Click" Visibility="Collapsed" Margin="4,0,0,0" ToolTip="{DynamicResource cam.hideTile}"
                        AutomationProperties.Name="{DynamicResource cam.hideTile}"/>
            </StackPanel>
        </Grid>
    </vlc:VideoView>
</UserControl>
