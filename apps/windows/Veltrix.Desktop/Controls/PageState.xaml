<UserControl x:Class="Veltrix.Desktop.Controls.PageState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared loading / empty / error states. DataContext: a PageViewModel. -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource state.loading}" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <Viewbox Width="64" Height="64" Opacity="0.55" x:Name="EmptySymbol">
                <Canvas Width="512" Height="512">
                    <Path Data="{StaticResource Logo.LeftBlade}" Stroke="{DynamicResource Brush.textSecondary}" StrokeThickness="10"/>
                    <Path Data="{StaticResource Logo.RightBlade}" Stroke="{DynamicResource Brush.textSecondary}" StrokeThickness="10"/>
                </Canvas>
            </Viewbox>
            <TextBlock Text="{DynamicResource state.empty}" HorizontalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource Text.Caption}" FontSize="14"/>
            <Button Content="{DynamicResource action.refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource err.generic}" Style="{StaticResource Text.Section}"/>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}"/>
                <Button Content="{DynamicResource action.retry}" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
