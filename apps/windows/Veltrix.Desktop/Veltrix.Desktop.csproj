<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the WPF app compile on Linux/macOS build agents (it can only RUN on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>VeltrixOS</AssemblyName>
    <RootNamespace>Veltrix.Desktop</RootNamespace>
    <ApplicationIcon>Assets\veltrix.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>VELTRIX OS</Product>
    <Description>VELTRIX OS for Windows</Description>
    <!-- Release version: dotnet publish -p:VeltrixVersion=1.2.3 -->
    <VeltrixVersion Condition="'$(VeltrixVersion)' == ''">0.1.0</VeltrixVersion>
    <Version>$(VeltrixVersion)</Version>
    <SatelliteResourceLanguages>en;fr;ar</SatelliteResourceLanguages>
    <!-- Optional: base64 SubjectPublicKeyInfo of the vendor license-signing key, pinned at build time
         (-p:VeltrixVendorPublicKey=MFkw...). When empty the key is trusted on first activation and stored encrypted. -->
    <VeltrixVendorPublicKey Condition="'$(VeltrixVendorPublicKey)' == ''"></VeltrixVendorPublicKey>
    <!-- Otherwise embed the repository's public vendor key (licensing/vendor-public-key.pem, SPKI PEM) when present.
         It enables offline activation; without it offline activation shows "not configured". Never a private key. -->
    <VeltrixVendorPublicKeyFile>$(MSBuildThisFileDirectory)../../../licensing/vendor-public-key.pem</VeltrixVendorPublicKeyFile>
    <VeltrixVendorPublicKey Condition="'$(VeltrixVendorPublicKey)' == '' And Exists('$(VeltrixVendorPublicKeyFile)')">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(VeltrixVendorPublicKeyFile)')), '-----[A-Z ]+-----|\s', ''))</VeltrixVendorPublicKey>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="VeltrixVendorPublicKey" Value="$(VeltrixVendorPublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Veltrix.Desktop.Core\Veltrix.Desktop.Core.csproj" />
    <ProjectReference Include="..\Veltrix.Desktop.Presentation\Veltrix.Desktop.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="LibVLCSharp.WPF" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>
  <!-- CCTV (RTSP live view): ship only the 64-bit libVLC and only the modules needed for RTSP H.264/H.265 cameras and JPEG/PNG
       snapshots (~27 MB instead of ~300 MB for all three architectures with every plugin). -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\access\liblive555_plugin.dll;plugins\access\librtp_plugin.dll;plugins\access\libhttp_plugin.dll;plugins\access\libtcp_plugin.dll;plugins\access\libudp_plugin.dll;plugins\access\libfilesystem_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\codec\libavcodec_plugin.dll;plugins\codec\libd3d11va_plugin.dll;plugins\codec\libdxva2_plugin.dll;plugins\codec\libjpeg_plugin.dll;plugins\codec\libpng_plugin.dll;plugins\codec\librawvideo_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\demux\libes_plugin.dll;plugins\demux\libh26x_plugin.dll;plugins\demux\libmjpeg_plugin.dll;plugins\demux\libps_plugin.dll;plugins\demux\librawvid_plugin.dll;plugins\demux\libts_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\packetizer\%2A;plugins\video_chroma\%2A;plugins\d3d11\%2A;plugins\d3d9\%2A;plugins\logger\%2A;plugins\video_filter\libdeinterlace_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\video_output\libdirect3d11_plugin.dll;plugins\video_output\libdirect3d9_plugin.dll;plugins\video_output\libwingdi_plugin.dll;plugins\video_output\libglwin32_plugin.dll;plugins\video_output\libgl_plugin.dll;plugins\video_output\libwgl_plugin.dll;plugins\video_output\libglinterop_dxva2_plugin.dll;plugins\video_output\libvmem_plugin.dll;plugins\video_output\libvdummy_plugin.dll;plugins\video_output\libdrawable_plugin.dll" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\symbol-256.png" />
    <Resource Include="Assets\veltrix.ico" />
    <Resource Include="Assets\veltrix-tray.ico" />
  </ItemGroup>
</Project>
