<UserControl x:Class="Veltrix.Desktop.Views.Workforce.WfAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource wf.nav.history}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}" DisplayMemberPath="Text" Width="200" IsEditable="False"
                          AutomationProperties.Name="{DynamicResource wf.col.Employee}"/>
                <Button Content="✕" Style="{StaticResource Button.Ghost}" Padding="6,2" Click="OnClearEmployee" AutomationProperties.Name="{DynamicResource wf.all}"/>
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding StatusFilter}" Width="130" Margin="8,0,0,0"
                          AutomationProperties.Name="{DynamicResource wf.col.Status}"/>
                <DatePicker SelectedDate="{Binding From}" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource wf.from}"/>
                <DatePicker SelectedDate="{Binding To}" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource wf.to}"/>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource action.export}" Command="{Binding ExportCsvCommand}" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource wf.chain.verify}" Command="{Binding VerifyChainCommand}" Margin="8,0,0,0"
                        Visibility="{Binding CanVerifyChain, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HeaderedContentControl>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding ChainStatus}" Style="{StaticResource Text.Caption}" Visibility="{Binding ChainStatus, Converter={StaticResource NotNullToVis}}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <DataGrid ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" IsReadOnly="True" AutoGenerateColumns="False"
                          Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource wf.col.Date}" Binding="{Binding DateText}" Width="95" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="#" Binding="{Binding EmployeeNo}" Width="70"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.Employee}" Binding="{Binding Employee}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.Shift}" Binding="{Binding Shift}" Width="70"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.Status}" Binding="{Binding StatusLabel}" Width="95"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.FirstIn}" Binding="{Binding FirstIn}" Width="70" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.LastOut}" Binding="{Binding LastOut}" Width="70" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.Worked}" Binding="{Binding Worked}" Width="65" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.LateMinutes}" Binding="{Binding Late}" Width="60" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.EarlyLeaveMinutes}" Binding="{Binding Early}" Width="60" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.OvertimeMinutes}" Binding="{Binding Overtime}" Width="60" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.Anomalies}" Binding="{Binding Anomalies}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <c:PageState/>
            </Grid>

            <!-- Raw punches of the selected day -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource wf.att.punches}" Style="{StaticResource Text.Section}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource wf.att.selectDay}" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding SelectedDay, Converter={StaticResource NullToVis}}"/>
                    <DataGrid ItemsSource="{Binding Punches}" SelectedItem="{Binding SelectedPunch}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource wf.col.Time}" Binding="{Binding Time}" Width="130" ElementStyle="{StaticResource Cell.Number}"/>
                            <DataGridTextColumn Header="{DynamicResource wf.col.Type}" Binding="{Binding TypeLabel}" Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource wf.col.Source}" Binding="{Binding Source}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource wf.col.Reason}" Binding="{Binding Reason}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource wf.col.AuthorizedBy}" Binding="{Binding AuthorizedBy}" Width="100"/>
                            <DataGridCheckBoxColumn Header="{DynamicResource wf.col.Voided}" Binding="{Binding IsVoid}" Width="60"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource wf.corr.requestVoid}" Style="{StaticResource Button.Ghost}" Padding="8,2"
                                                Command="{Binding DataContext.RequestVoidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsVoid, Converter={StaticResource InvBoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Correction request form -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding CanRequest, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource wf.corr.request}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{DynamicResource wf.col.Employee}" Style="{StaticResource Text.Label}"/>
                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding CorrectionEmployee}" DisplayMemberPath="Text"/>
                        <TextBlock Text="{DynamicResource wf.corr.kind}" Style="{StaticResource Text.Label}"/>
                        <ComboBox ItemsSource="{Binding CorrectionKindChoices}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding CorrectionKind}"/>
                        <StackPanel Visibility="{Binding IsAddPunch, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource wf.col.Type}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding PunchTypeChoices}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding CorrectionPunchType}"/>
                            <TextBlock Text="{DynamicResource wf.col.Date}" Style="{StaticResource Text.Label}"/>
                            <DatePicker SelectedDate="{Binding CorrectionDate}"/>
                            <TextBlock Text="{DynamicResource wf.corr.time}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding CorrectionTime}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsAddPunch, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="{DynamicResource wf.corr.target}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding SelectedPunch.Time}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource wf.corr.selectPunchHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedPunch, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource wf.col.Reason}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding CorrectionReason}" AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                        <Button Content="{DynamicResource wf.corr.submit}" Command="{Binding RequestCorrectionCommand}" Style="{StaticResource Button.Primary}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Correction requests -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding CorrectionFilters}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding CorrectionFilter}" Width="120"/>
                        <TextBlock Text="{DynamicResource wf.corr.title}" Style="{StaticResource Text.Section}"/>
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top" Text="{Binding DecisionNote}" Margin="0,4,0,6" AutomationProperties.Name="{DynamicResource wf.corr.note}"
                             Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource wf.corr.note}"/>
                    <ListBox ItemsSource="{Binding Corrections}" ItemContainerStyle="{StaticResource Item.Selectable}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding EmployeeNo, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding Employee, Mode=OneWay}"/>
                                        · <Run Text="{Binding Kind, Mode=OneWay}"/> <Run Text="{Binding PunchType, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding StatusLabel, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding RequestedBy, Mode=OneWay}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                        <Button Content="{DynamicResource action.approve}" Style="{StaticResource Button.Primary}" Padding="10,3"
                                                Command="{Binding DataContext.ApproveCorrectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanApprove, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="{DynamicResource action.reject}" Style="{StaticResource Button.Danger}" Padding="10,3" Margin="6,0,0,0"
                                                Command="{Binding DataContext.RejectCorrectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanApprove, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
