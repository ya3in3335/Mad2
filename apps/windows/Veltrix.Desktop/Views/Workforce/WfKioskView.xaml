<UserControl x:Class="Veltrix.Desktop.Views.Workforce.WfKioskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <DockPanel>
        <HeaderedContentControl x:Name="Header" DockPanel.Dock="Top" Header="{DynamicResource wf.nav.kiosk}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource wf.kiosk.fullScreen}" Command="{Binding EnterFullScreenCommand}" Style="{StaticResource Button.Primary}"
                        Visibility="{Binding IsFullScreen, Converter={StaticResource InvBoolToVis}}"/>
                <Button Content="{DynamicResource wf.kiosk.exit}" Command="{Binding ExitFullScreenCommand}"
                        Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HeaderedContentControl>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Clock, scan capture and result -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Clock}" FontSize="96" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" HorizontalAlignment="Center"
                               FlowDirection="LeftToRight" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Brush.textPrimary}"/>
                    <TextBlock Text="{Binding DateLine}" FontSize="22" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,24,0,0" MaxWidth="640">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource wf.kiosk.scanPrompt}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center"/>
                        <!-- Keyboard-wedge readers type the UID / QR text here followed by Enter. -->
                        <TextBox x:Name="ScanBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" FontSize="24" MinHeight="56" Padding="16,8"
                                 FlowDirection="LeftToRight" HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource wf.kiosk.scanPrompt}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SubmitScanCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{DynamicResource wf.kiosk.scanHint}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,24,0,0" MaxWidth="640">
                    <Border x:Name="FeedbackCard" CornerRadius="{StaticResource Radius.Large}" Padding="24" BorderThickness="2" RenderTransformOrigin="0.5,0.5"
                            Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FeedbackScale"/>
                                <TranslateTransform x:Name="FeedbackShift"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.dangerSoft}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.danger}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Feedback.Success}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.successSoft}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Feedback.Title}" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.textPrimary}"/>
                            <TextBlock Text="{Binding Feedback.EmployeeName}" FontSize="28" HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Visibility="{Binding Feedback.EmployeeName, Converter={StaticResource NotNullToVis}}"/>
                            <TextBlock Text="{Binding Feedback.Detail}" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Feedback.Time}" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0" FlowDirection="LeftToRight"
                                       Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                    </Border>
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="4" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DockPanel>

            <!-- PIN keypad (buttons never take the focus, so the reader capture box keeps it) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{DynamicResource wf.kiosk.pinTitle}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{DynamicResource wf.kiosk.employeeNo}" Style="{StaticResource Text.Label}"/>
                    <Button Command="{Binding FocusEmployeeCommand}" Focusable="False" HorizontalContentAlignment="Stretch" MinHeight="48">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KeypadOnEmployee}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.primary}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding PinEmployeeNo}" FontSize="22" FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="{DynamicResource wf.kiosk.pin}" Style="{StaticResource Text.Label}"/>
                    <Button Command="{Binding FocusPinCommand}" Focusable="False" HorizontalContentAlignment="Stretch" MinHeight="48">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KeypadOnEmployee}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource Brush.primary}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding PinMask}" FontSize="22" FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
                    </Button>
                    <ItemsControl ItemsSource="{x:Static vm:WfKioskViewModel.KeypadDigits}" Margin="0,12,0,0" Focusable="False" FlowDirection="LeftToRight">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" FontSize="26" MinHeight="64" Margin="4" Focusable="False"
                                        Command="{Binding DataContext.KeypadDigitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <UniformGrid Columns="3" FlowDirection="LeftToRight">
                        <Button Content="⌫" FontSize="22" MinHeight="64" Margin="4" Focusable="False" Command="{Binding KeypadBackspaceCommand}"
                                AutomationProperties.Name="{DynamicResource wf.kiosk.backspace}"/>
                        <Button Content="0" FontSize="26" MinHeight="64" Margin="4" Focusable="False" Command="{Binding KeypadDigitCommand}" CommandParameter="0"/>
                        <Button Content="{DynamicResource wf.kiosk.ok}" FontSize="22" MinHeight="64" Margin="4" Focusable="False" Style="{StaticResource Button.Primary}"
                                Command="{Binding KeypadOkCommand}"/>
                    </UniformGrid>
                    <Button Content="{DynamicResource wf.kiosk.clear}" Command="{Binding KeypadClearCommand}" Focusable="False" Style="{StaticResource Button.Ghost}"
                            Margin="4,8,4,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
