<UserControl x:Class="Veltrix.Desktop.Views.Workforce.WfTerminalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource wf.nav.terminals}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource action.refresh}" Command="{Binding RefreshCommand}"/>
                <Button Content="{DynamicResource wf.term.register}" Command="{Binding NewCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding ConnectorStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource wf.term.privacyNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False"
                          Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource wf.emp.name}" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.manufacturer}" Binding="{Binding Manufacturer}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.model}" Binding="{Binding Model}" Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.serial}" Binding="{Binding SerialNumber}" Width="120"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.address}" Binding="{Binding Address}" Width="130"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.branch}" Binding="{Binding Branch}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.Status}" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.lastConnection}" Binding="{Binding LastConnection}" Width="125"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.lastSync}" Binding="{Binding LastSync}" Width="125"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.drift}" Binding="{Binding Drift}" Width="70" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="{DynamicResource wf.term.firmware}" Binding="{Binding Firmware}" Width="90"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.ErrorCount}" Binding="{Binding ErrorCount}" Width="60" ElementStyle="{StaticResource Cell.Number}"/>
                        <DataGridTextColumn Header="{DynamicResource wf.col.LastError}" Binding="{Binding LastError}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
                <c:PageState/>
            </Grid>

            <TabControl Grid.Row="1" Margin="0,12,0,0" Height="260" Visibility="{Binding ShowEvents, Converter={StaticResource BoolToVis}}">
                <TabItem Header="{DynamicResource wf.term.events}">
                    <DataGrid ItemsSource="{Binding Events}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource wf.col.Time}" Binding="{Binding Time}" Width="130"/>
                            <DataGridTextColumn Header="{DynamicResource wf.term.terminalUser}" Binding="{Binding User}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource wf.term.card}" Binding="{Binding Card}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource wf.term.method}" Binding="{Binding Method}" Width="70"/>
                            <DataGridTextColumn Header="{DynamicResource wf.term.verify}" Binding="{Binding Verify}" Width="80"/>
                            <DataGridTextColumn Header="{DynamicResource wf.col.Status}" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource wf.rev.reason}" Binding="{Binding Reason}" Width="130"/>
                            <DataGridTextColumn Header="{DynamicResource wf.term.provenance}" Binding="{Binding Provenance}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{DynamicResource wf.term.logs}">
                    <ListBox ItemsSource="{Binding Logs}" FontFamily="{StaticResource Font.Mono}" FlowDirection="LeftToRight"/>
                </TabItem>
            </TabControl>

            <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Card}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource wf.dev.device}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{DynamicResource wf.emp.name}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Name}"/>
                        <TextBlock Text="{DynamicResource wf.term.manufacturer}" Style="{StaticResource Text.Label}"/>
                        <ComboBox ItemsSource="{x:Static vm:WfTerminalsViewModel.Manufacturers}" SelectedItem="{Binding Manufacturer}"/>
                        <TextBlock Text="{DynamicResource wf.term.zkNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding IsZkTeco, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource wf.term.simNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource wf.term.vendorNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{DynamicResource wf.term.host}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Host}" FlowDirection="LeftToRight"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource wf.term.port}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding Port}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource wf.term.protocol}" Style="{StaticResource Text.Label}"/>
                                <ComboBox ItemsSource="{x:Static vm:WfTerminalsViewModel.Protocols}" SelectedItem="{Binding Protocol}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource wf.term.user}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding UserName}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{DynamicResource wf.term.password}" Style="{StaticResource Text.Label}"/>
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{DynamicResource wf.term.passwordHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                        <CheckBox Content="{DynamicResource wf.term.clearPassword}" IsChecked="{Binding ClearPassword}" Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource wf.term.remoteId}" Style="{StaticResource Text.Label}" Visibility="{Binding IsSuprema, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="{Binding RemoteDeviceId}" FlowDirection="LeftToRight" Visibility="{Binding IsSuprema, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource wf.term.certPin}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding CertificatePin}" FlowDirection="LeftToRight" FontFamily="{StaticResource Font.Mono}"/>
                        <TextBlock Text="{DynamicResource wf.term.branch}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Branch}"/>
                        <TextBlock Text="{DynamicResource wf.term.location}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Location}"/>
                        <TextBlock Text="{DynamicResource wf.access.direction}" Style="{StaticResource Text.Label}"/>
                        <ComboBox ItemsSource="{x:Static vm:WfTerminalsViewModel.Directions}" SelectedItem="{Binding Direction}"/>
                        <TextBlock Text="{DynamicResource wf.term.offset}" Style="{StaticResource Text.Label}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding OffsetMinutes}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{DynamicResource wf.term.poll}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding PollSeconds}" FlowDirection="LeftToRight"/>
                        <CheckBox Content="{DynamicResource wf.term.applyDrift}" IsChecked="{Binding ApplyDrift}" Margin="0,10,0,0"/>
                        <TextBlock Text="{DynamicResource wf.term.driftTolerance}" Style="{StaticResource Text.Label}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding DriftTolerance}" FlowDirection="LeftToRight"/>
                        <CheckBox Content="{DynamicResource wf.dev.enabled}" IsChecked="{Binding IsEnabled}" Margin="0,10,0,0"/>

                        <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{DynamicResource action.save}" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,8"/>
                            <Button Content="{DynamicResource action.cancel}" Command="{Binding CancelCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <WrapPanel Visibility="{Binding Selected, Converter={StaticResource NotNullToVis}}">
                            <Button Content="{DynamicResource wf.term.diagnose}" Command="{Binding DiagnoseCommand}" Margin="0,0,8,8"/>
                            <Button Content="{DynamicResource wf.term.syncNow}" Command="{Binding SyncNowCommand}" Margin="0,0,8,8"/>
                            <Button Content="{DynamicResource wf.term.events}" Command="{Binding LoadEventsCommand}" Margin="0,0,8,8"/>
                            <Button Content="{DynamicResource wf.term.toggle}" Command="{Binding ToggleEnabledCommand}" Margin="0,0,8,8"/>
                            <Button Content="{DynamicResource wf.term.remove}" Command="{Binding RemoveCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="{StaticResource Radius.Control}" Visibility="{Binding TestResult, Converter={StaticResource NotNullToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.dangerSoft}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestOk}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.successSoft}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
