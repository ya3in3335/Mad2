<UserControl x:Class="Veltrix.Desktop.Views.Workforce.WfOvertimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource wf.nav.overtime}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding StatusFilter}" Width="130"
                          AutomationProperties.Name="{DynamicResource wf.col.Status}"/>
                <DatePicker SelectedDate="{Binding From}" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource wf.from}"/>
                <DatePicker SelectedDate="{Binding To}" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource wf.to}"/>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource action.export}" Command="{Binding ExportCsvCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                <TextBlock><Run Text="{DynamicResource wf.ot.totalPending}"/>: <Run Text="{Binding TotalPending, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
            </Border>
            <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.successSoft}">
                <TextBlock><Run Text="{DynamicResource wf.ot.totalApproved}"/>: <Run Text="{Binding TotalApproved, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
            </Border>
            <TextBox Text="{Binding Note}" Width="240" Margin="16,0,0,0" ToolTip="{DynamicResource wf.corr.note}" AutomationProperties.Name="{DynamicResource wf.corr.note}"
                     Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{DynamicResource wf.ot.approveAll}" Command="{Binding ApproveAllCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                    Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"/>
        <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource wf.ot.note}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Grid>
            <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource wf.col.Date}" Binding="{Binding DateText}" Width="100" ElementStyle="{StaticResource Cell.Number}"/>
                    <DataGridTextColumn Header="#" Binding="{Binding EmployeeNo}" Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource wf.col.Employee}" Binding="{Binding Employee}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource wf.col.Shift}" Binding="{Binding Shift}" Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource wf.col.Worked}" Binding="{Binding Worked}" Width="80" ElementStyle="{StaticResource Cell.Number}"/>
                    <DataGridTextColumn Header="{DynamicResource wf.col.OvertimeMinutes}" Binding="{Binding Overtime}" Width="90" ElementStyle="{StaticResource Cell.Number}"/>
                    <DataGridTextColumn Header="{DynamicResource wf.col.Night}" Binding="{Binding Night}" Width="80" ElementStyle="{StaticResource Cell.Number}"/>
                    <DataGridTextColumn Header="{DynamicResource wf.col.Status}" Binding="{Binding StatusLabel}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource wf.col.DecidedBy}" Binding="{Binding DecidedBy}" Width="100"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.CanApprove, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}">
                                    <Button Content="{DynamicResource action.approve}" Style="{StaticResource Button.Primary}" Padding="8,2"
                                            Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    <Button Content="{DynamicResource action.reject}" Style="{StaticResource Button.Danger}" Padding="8,2" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <c:PageState/>
        </Grid>
    </DockPanel>
</UserControl>
