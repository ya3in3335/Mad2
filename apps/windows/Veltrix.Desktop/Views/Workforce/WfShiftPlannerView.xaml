<UserControl x:Class="Veltrix.Desktop.Views.Workforce.WfShiftPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource wf.nav.shifts}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{DynamicResource wf.shift.week}" IsChecked="{Binding IsWeek}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton Content="{DynamicResource wf.shift.month}" IsChecked="{Binding IsMonth}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="‹" Command="{Binding PreviousCommand}" AutomationProperties.Name="{DynamicResource wf.shift.previous}" Padding="12,4"/>
                <Button Content="{DynamicResource wf.shift.today}" Command="{Binding GoTodayCommand}" Margin="6,0,0,0"/>
                <Button Content="›" Command="{Binding NextCommand}" AutomationProperties.Name="{DynamicResource wf.shift.next}" Padding="12,4" Margin="6,0,0,0"/>
                <TextBlock Text="{Binding PeriodTitle}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Planning grid: one row per employee, one cell per day (conflicts highlighted). -->
            <Grid>
                <Border Style="{StaticResource Card}" Padding="8" Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="180" Text="{DynamicResource wf.col.Employee}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                                <ItemsControl ItemsSource="{Binding Headers}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="52" Margin="1,0">
                                                <TextBlock Text="{Binding Day}" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                                                <TextBlock Text="{Binding Date}" HorizontalAlignment="Center" FontWeight="SemiBold" FlowDirection="LeftToRight">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.primary}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Width="180" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding EmployeeNo, Mode=OneWay}" Foreground="{DynamicResource Brush.textSecondary}"/> <Run Text="{Binding Employee, Mode=OneWay}"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="52" Height="34" Margin="1,0" Padding="0" Content="{Binding Code}" ToolTip="{Binding Tooltip}" FontSize="12"
                                                                Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.primarySoft}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRest}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.surfaceSunken}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsHoliday}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.accentSoft}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.primary}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.dangerSoft}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.danger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <c:PageState/>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- Selected cell: one-day override -->
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding SelectedCell, Converter={StaticResource NotNullToVis}}" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Text.Section}">
                            <Run Text="{DynamicResource wf.shift.override}"/> <Run Text="{Binding SelectedCell.Code, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedCell.Tooltip}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource wf.shift.apply}" Command="{Binding ApplyOverrideCommand}" Margin="8,0,0,0"/>
                            <ComboBox ItemsSource="{Binding OverrideChoices}" SelectedValuePath="Value" DisplayMemberPath="Text" SelectedValue="{Binding OverrideTemplateId}"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"
                               Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                    <TabControl>
                        <TabItem Header="{DynamicResource wf.shift.assign}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource wf.col.Employee}" Style="{StaticResource Text.Label}"/>
                                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding AssignEmployee}" DisplayMemberPath="Text"/>
                                    <CheckBox Content="{DynamicResource wf.shift.useRotation}" IsChecked="{Binding AssignUseRotation}" Margin="0,10,0,0"/>
                                    <StackPanel Visibility="{Binding AssignUseRotation, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="{DynamicResource wf.shift.template}" Style="{StaticResource Text.Label}"/>
                                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding AssignTemplate}" DisplayMemberPath="Name"/>
                                        <TextBlock Text="{DynamicResource wf.shift.days}" Style="{StaticResource Text.Label}"/>
                                        <ItemsControl ItemsSource="{Binding Weekdays}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,0,10,4"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding AssignUseRotation, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource wf.shift.rotation}" Style="{StaticResource Text.Label}"/>
                                        <ComboBox ItemsSource="{Binding Rotations}" SelectedItem="{Binding AssignRotation}" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource wf.from}" Style="{StaticResource Text.Label}"/>
                                    <DatePicker SelectedDate="{Binding AssignFrom}"/>
                                    <TextBlock Text="{DynamicResource wf.toOptional}" Style="{StaticResource Text.Label}"/>
                                    <DatePicker SelectedDate="{Binding AssignTo}"/>
                                    <CheckBox Content="{DynamicResource wf.shift.replace}" IsChecked="{Binding ReplaceOverlaps}" Margin="0,10,0,0"/>
                                    <Button Content="{DynamicResource wf.shift.assign}" Command="{Binding AssignCommand}" Style="{StaticResource Button.Primary}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{DynamicResource wf.shift.templates}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,8,0,0">
                                    <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MaxHeight="160" ItemContainerStyle="{StaticResource Item.Selectable}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate><TextBlock><Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding Name, Mode=OneWay}"/></TextBlock></DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Visibility="{Binding CanManageGlobal, Converter={StaticResource BoolToVis}}">
                                        <Button Content="{DynamicResource action.new}" Command="{Binding NewTemplateCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        <TextBlock Text="{DynamicResource wf.shift.code}" Style="{StaticResource Text.Label}"/>
                                        <TextBox Text="{Binding TplCode}" FlowDirection="LeftToRight"/>
                                        <TextBlock Text="{DynamicResource wf.emp.name}" Style="{StaticResource Text.Label}"/>
                                        <TextBox Text="{Binding TplName}"/>
                                        <TextBlock Text="{DynamicResource wf.shift.segments}" Style="{StaticResource Text.Label}"/>
                                        <TextBox Text="{Binding TplSegments}" FlowDirection="LeftToRight"/>
                                        <TextBlock Text="{DynamicResource wf.shift.segmentsHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                        <UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource wf.shift.break}" Style="{StaticResource Text.Label}"/>
                                                <TextBox Text="{Binding TplBreak}" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource wf.shift.graceIn}" Style="{StaticResource Text.Label}"/>
                                                <TextBox Text="{Binding TplGraceIn}" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource wf.shift.graceOut}" Style="{StaticResource Text.Label}"/>
                                                <TextBox Text="{Binding TplGraceOut}" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <CheckBox Content="{DynamicResource wf.shift.flexible}" IsChecked="{Binding TplFlexible}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{DynamicResource wf.shift.required}" Style="{StaticResource Text.Label}" Visibility="{Binding TplFlexible, Converter={StaticResource BoolToVis}}"/>
                                        <TextBox Text="{Binding TplRequired}" FlowDirection="LeftToRight" Visibility="{Binding TplFlexible, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="{DynamicResource action.save}" Command="{Binding SaveTemplateCommand}" Style="{StaticResource Button.Primary}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{DynamicResource wf.shift.rotations}">
                            <StackPanel Margin="0,8,0,0">
                                <ListBox ItemsSource="{Binding Rotations}" SelectedItem="{Binding SelectedRotation}" DisplayMemberPath="Name" MaxHeight="160"
                                         ItemContainerStyle="{StaticResource Item.Selectable}"/>
                                <StackPanel Visibility="{Binding CanManageGlobal, Converter={StaticResource BoolToVis}}">
                                    <Button Content="{DynamicResource action.new}" Command="{Binding NewRotationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    <TextBlock Text="{DynamicResource wf.emp.name}" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding RotName}"/>
                                    <TextBlock Text="{DynamicResource wf.shift.pattern}" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding RotPattern}" FlowDirection="LeftToRight"/>
                                    <TextBlock Text="{DynamicResource wf.shift.patternHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                    <Button Content="{DynamicResource action.save}" Command="{Binding SaveRotationCommand}" Style="{StaticResource Button.Primary}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="{DynamicResource wf.shift.swaps}">
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding CanRequestSwap, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource wf.swap.employee1}" Style="{StaticResource Text.Label}"/>
                                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SwapEmployee1}" DisplayMemberPath="Text"/>
                                    <DatePicker SelectedDate="{Binding SwapDate1}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{DynamicResource wf.swap.employee2}" Style="{StaticResource Text.Label}"/>
                                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SwapEmployee2}" DisplayMemberPath="Text"/>
                                    <DatePicker SelectedDate="{Binding SwapDate2}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{DynamicResource wf.col.Reason}" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding SwapReason}"/>
                                    <Button Content="{DynamicResource wf.swap.request}" Command="{Binding RequestSwapCommand}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Swaps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.hairline}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Requester, Mode=OneWay}" FontWeight="SemiBold"/> (<Run Text="{Binding RequesterDate, Mode=OneWay}"/>) ⇄
                                                        <Run Text="{Binding Counterpart, Mode=OneWay}" FontWeight="SemiBold"/> (<Run Text="{Binding CounterpartDate, Mode=OneWay}"/>)
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding StatusLabel, Mode=OneWay}"/> · <Run Text="{Binding Reason, Mode=OneWay}"/></TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                                        <Button Content="{DynamicResource action.approve}" Style="{StaticResource Button.Primary}" Padding="10,3"
                                                                Command="{Binding DataContext.ApproveSwapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding DataContext.CanApproveSwap, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                                        <Button Content="{DynamicResource action.reject}" Style="{StaticResource Button.Danger}" Padding="10,3" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.RejectSwapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding DataContext.CanApproveSwap, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="{DynamicResource wf.shift.conflicts}">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource wf.shift.noConflicts}" Style="{StaticResource Text.Caption}"
                                           Visibility="{Binding Conflicts.Count, Converter={StaticResource EqualsZeroToVis}}"/>
                                <ItemsControl ItemsSource="{Binding Conflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock><Run Text="{Binding Date, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding Employee, Mode=OneWay}"/></TextBlock>
                                                <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Brush.danger}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
