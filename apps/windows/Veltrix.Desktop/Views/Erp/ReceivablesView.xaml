<UserControl x:Class="Veltrix.Desktop.Views.Erp.ReceivablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource erp.nav.receivables}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="{DynamicResource erp.withBalanceOnly}" IsChecked="{Binding WithBalanceOnly}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="{DynamicResource action.search}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchNowCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            <!-- Customers and balances -->
            <Grid>
                <DockPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource erp.totalReceivable}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalReceivable, StringFormat=N2}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource erp.name}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource erp.phone}" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="{DynamicResource erp.creditLimit}" Binding="{Binding CreditLimit, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                            <DataGridTextColumn Header="{DynamicResource erp.balance}" Binding="{Binding Balance, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Cell.Number}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <c:PageState/>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl SelectedIndex="{Binding TabIndex}">
                    <!-- Payment -->
                    <TabItem Header="{DynamicResource erp.payment}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.Section}"/>
                                <TextBlock Text="{DynamicResource erp.selectCustomer}" Style="{StaticResource Text.Caption}"
                                           Visibility="{Binding Selected, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{DynamicResource erp.amount}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                <TextBlock Text="{DynamicResource erp.method}" Style="{StaticResource Text.Label}"/>
                                <ComboBox ItemsSource="{x:Static vm:ErpPageViewModel.PayMethodsList}" SelectedItem="{Binding PayMethod}"/>
                                <TextBlock Text="{DynamicResource erp.date}" Style="{StaticResource Text.Label}"/>
                                <DatePicker SelectedDate="{Binding PayDate}"/>
                                <TextBlock Text="{DynamicResource erp.notes}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding PayNotes}"/>
                                <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                                <Button Content="{DynamicResource erp.receivePayment}" Command="{Binding ReceivePaymentCommand}" Style="{StaticResource Button.Primary}" Margin="0,10,0,0"/>
                                <TextBlock Text="{DynamicResource erp.paymentsHistory}" Style="{StaticResource Text.Section}" Margin="0,20,0,4"/>
                                <ItemsControl ItemsSource="{Binding Payments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, StringFormat=N2}"/>
                                                <TextBlock Text="{Binding Date}" Style="{StaticResource Text.Caption}" Width="85" VerticalAlignment="Center"/>
                                                <TextBlock><Run Text="{Binding Number, Mode=OneWay}"/> · <Run Text="{Binding Method, Mode=OneWay}"/></TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Credit sale -->
                    <TabItem Header="{DynamicResource erp.creditSale}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.Section}"/>
                                <TextBlock Text="{DynamicResource erp.selectCustomer}" Style="{StaticResource Text.Caption}"
                                           Visibility="{Binding Selected, Converter={StaticResource NullToVis}}"/>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource action.add}" Command="{Binding AddSaleLineCommand}" Margin="8,0,0,0"/>
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Picker.Results}" SelectedItem="{Binding Picker.Selected}" Width="170" Margin="8,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock><Run Text="{Binding Sku, Mode=OneWay}"/> · <Run Text="{Binding Name, Mode=OneWay}"/></TextBlock></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Text="{Binding Picker.Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource erp.findProduct}">
                                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding Picker.SearchCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding SaleLines}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,0" MinHeight="120">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource erp.product}" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource erp.qty}" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                        <DataGridTextColumn Header="{DynamicResource erp.price}" Binding="{Binding UnitPrice}" IsReadOnly="True" Width="80"/>
                                        <DataGridTextColumn Header="{DynamicResource erp.total}" Binding="{Binding Total, StringFormat=N2, Mode=OneWay}" IsReadOnly="True" Width="90" ElementStyle="{StaticResource Cell.Number}"/>
                                        <DataGridTemplateColumn Width="36">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Style="{StaticResource Button.Ghost}" Padding="4,0" AutomationProperties.Name="{DynamicResource erp.removeLine}"
                                                            Command="{Binding DataContext.RemoveSaleLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SaleTotal, StringFormat=N2}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource erp.total}" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                                <Button Content="{DynamicResource erp.recordCreditSale}" Command="{Binding CreditSaleCommand}" Style="{StaticResource Button.Primary}" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding LastSaleNumber}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Sales return -->
                    <TabItem Header="{DynamicResource erp.salesReturn}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource erp.receiptNumber}" Style="{StaticResource Text.Label}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource action.search}" Command="{Binding FindSaleCommand}" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight">
                                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding FindSaleCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                                <StackPanel Visibility="{Binding ReturnSale, Converter={StaticResource NotNullToVis}}" Margin="0,8,0,0">
                                    <TextBlock><Run Text="{Binding ReturnSale.Sale.ClientNumber, Mode=OneWay}"/> · <Run Text="{Binding ReturnSale.Sale.Total, Mode=OneWay, StringFormat=N2}"/> · <Run Text="{Binding ReturnSale.CustomerName, Mode=OneWay}"/></TextBlock>
                                    <DataGrid ItemsSource="{Binding ReturnLines}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource erp.product}" Binding="{Binding Source.Line.Name}" IsReadOnly="True" Width="*"/>
                                            <DataGridTextColumn Header="{DynamicResource erp.returnable}" Binding="{Binding Source.Returnable, StringFormat={}{0:0.###}, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                            <DataGridTextColumn Header="{DynamicResource erp.qty}" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{DynamicResource erp.refundMethod}" Style="{StaticResource Text.Label}"/>
                                    <ComboBox ItemsSource="{x:Static vm:ReceivablesViewModel.RefundMethodsList}" SelectedItem="{Binding RefundMethod}"/>
                                    <TextBlock Text="{DynamicResource erp.reason}" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding ReturnReason}"/>
                                    <Button Content="{DynamicResource erp.recordReturn}" Command="{Binding SubmitReturnCommand}" Style="{StaticResource Button.Primary}" Margin="0,10,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
