<UserControl x:Class="Veltrix.Desktop.Views.Erp.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource erp.nav.suppliers}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="{DynamicResource erp.activeOnly}" IsChecked="{Binding ActiveOnly}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="240" AutomationProperties.Name="{DynamicResource action.search}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchNowCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource action.new}" Command="{Binding NewCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <DockPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource erp.totalOwed}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalOwed, StringFormat=N2}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource erp.name}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource erp.phone}" Binding="{Binding Phone}" Width="130"/>
                            <DataGridCheckBoxColumn Header="{DynamicResource erp.active}" Binding="{Binding IsActive}" Width="70"/>
                            <DataGridTextColumn Header="{DynamicResource erp.balance}" Binding="{Binding Balance, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Cell.Number}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <c:PageState/>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding Editor, Converter={StaticResource NotNullToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Editor}">
                            <TextBlock Text="{DynamicResource erp.supplier}" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{DynamicResource erp.name}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Name}"/>
                            <TextBlock Text="{DynamicResource erp.phone}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Phone}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource erp.email}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Email}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource erp.address}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Address}"/>
                            <TextBlock Text="{DynamicResource erp.taxId}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding TaxId}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource erp.notes}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Notes}" AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap"/>
                            <CheckBox Content="{DynamicResource erp.active}" IsChecked="{Binding IsActive}" Margin="0,10,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                        <Button Content="{DynamicResource action.save}" Style="{StaticResource Button.Primary}" Margin="0,12,0,0" Command="{Binding SaveCommand}"/>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource erp.payment}" Style="{StaticResource Text.Section}" Margin="0,20,0,4"/>
                            <TextBlock Text="{DynamicResource erp.amount}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource erp.method}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{x:Static vm:ErpPageViewModel.PayMethodsList}" SelectedItem="{Binding PayMethod}"/>
                            <TextBlock Text="{DynamicResource erp.date}" Style="{StaticResource Text.Label}"/>
                            <DatePicker SelectedDate="{Binding PayDate}"/>
                            <TextBlock Text="{DynamicResource erp.notes}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding PayNotes}"/>
                            <Button Content="{DynamicResource erp.pay}" Command="{Binding PayCommand}" Margin="0,10,0,0"/>

                            <TextBlock Text="{DynamicResource erp.statement}" Style="{StaticResource Text.Section}" Margin="0,20,0,4"/>
                            <ItemsControl ItemsSource="{Binding Statement}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Balance, StringFormat=N2}" Width="90" TextAlignment="Right"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Decrease, StringFormat=N2}" Width="80" TextAlignment="Right" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Increase, StringFormat=N2}" Width="80" TextAlignment="Right" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock Text="{Binding Date}" Style="{StaticResource Text.Caption}" Width="80" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Number}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
