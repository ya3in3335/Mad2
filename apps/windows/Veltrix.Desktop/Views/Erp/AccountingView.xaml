<UserControl x:Class="Veltrix.Desktop.Views.Erp.AccountingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <UserControl.Resources>
        <!-- Two-column statement section (code · name · amount) -->
        <DataTemplate x:Key="StatementLineTemplate">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, StringFormat=N2}" Style="{StaticResource Cell.Number}" Width="130"/>
                <TextBlock Text="{Binding Code}" Width="60" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource erp.nav.accounting}" Style="{StaticResource PageHeader}">
            <WrapPanel Orientation="Horizontal">
                <DatePicker SelectedDate="{Binding From}" Width="130" Margin="0,0,4,0" AutomationProperties.Name="{DynamicResource erp.from}"/>
                <DatePicker SelectedDate="{Binding To}" Width="130" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource erp.to}"/>
                <Button Content="{DynamicResource erp.apply}" Command="{Binding ApplyCommand}"/>
                <Button Content="{DynamicResource erp.newEntry}" Command="{Binding NewEntryCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"/>
            </WrapPanel>
        </HeaderedContentControl>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TabControl SelectedIndex="{Binding TabIndex}">
                    <!-- Journal -->
                    <TabItem Header="{DynamicResource erp.journal}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox ItemsSource="{x:Static vm:AccountingViewModel.Sources}" SelectedItem="{Binding Source}" Width="160" Margin="0,0,8,0"
                                          AutomationProperties.Name="{DynamicResource erp.source}"/>
                                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="{DynamicResource action.search}">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding ApplyCommand}"/></TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <DataGrid DockPanel.Dock="Bottom" ItemsSource="{Binding SelectedEntry.Lines}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="220" Margin="0,8,0,0"
                                      Visibility="{Binding SelectedEntry, Converter={StaticResource NotNullToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource erp.account}" Binding="{Binding Line.AccountCode}" Width="80"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.name}" Binding="{Binding AccountName}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.description}" Binding="{Binding Line.Description}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.debit}" Binding="{Binding Line.Debit, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.credit}" Binding="{Binding Line.Credit, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid ItemsSource="{Binding Journal}" SelectedItem="{Binding SelectedEntry}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Entry.Number}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.date}" Binding="{Binding Entry.Date}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.source}" Binding="{Binding Entry.Source}" Width="120"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.description}" Binding="{Binding Entry.Description}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.amount}" Binding="{Binding Entry.TotalDebit, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Cell.Number}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- General ledger -->
                    <TabItem Header="{DynamicResource erp.ledger}">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Accounts}" SelectedItem="{Binding LedgerAccount}" DisplayMemberPath="Text" Width="360"
                                      HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource erp.account}"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource erp.opening}" Style="{StaticResource Text.Caption}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Ledger.Opening, StringFormat=N2}" Margin="0,0,24,0"/>
                                <TextBlock Text="{DynamicResource erp.closing}" Style="{StaticResource Text.Caption}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Ledger.Closing, StringFormat=N2}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Ledger.Rows}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource erp.date}" Binding="{Binding Date}" Width="100"/>
                                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.description}" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.debit}" Binding="{Binding Debit, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.credit}" Binding="{Binding Credit, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.balance}" Binding="{Binding Balance, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Cell.Number}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Trial balance -->
                    <TabItem Header="{DynamicResource erp.trialBalance}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Left" Content="{DynamicResource action.export}" Command="{Binding ExportTrialBalanceCommand}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource erp.unbalancedWarning}" Style="{StaticResource Text.Error}" Margin="0,0,16,0"
                                               Visibility="{Binding TrialBalance.IsBalanced, Converter={StaticResource InvBoolToVis}}"/>
                                    <TextBlock Text="{Binding TrialBalance.TotalDebit, StringFormat=N2}" Width="130" TextAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TrialBalance.TotalCredit, StringFormat=N2}" Width="130" TextAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Width="130"/>
                                </StackPanel>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding TrialBalance.Rows}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource erp.account}" Binding="{Binding Code}" Width="80"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.name}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.debit}" Binding="{Binding Debit, StringFormat=N2}" Width="130" ElementStyle="{StaticResource Cell.Number}"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.credit}" Binding="{Binding Credit, StringFormat=N2}" Width="130" ElementStyle="{StaticResource Cell.Number}"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.balance}" Binding="{Binding Balance, StringFormat=N2}" Width="130" ElementStyle="{StaticResource Cell.Number}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Income statement -->
                    <TabItem Header="{DynamicResource erp.incomeStatement}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource erp.revenue}" Style="{StaticResource Text.Section}"/>
                                <ItemsControl ItemsSource="{Binding IncomeStatement.Revenue}" ItemTemplate="{StaticResource StatementLineTemplate}"/>
                                <DockPanel Margin="0,4,0,12">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IncomeStatement.TotalRevenue, StringFormat=N2}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource erp.totalRevenue}" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Text="{DynamicResource erp.expensesSection}" Style="{StaticResource Text.Section}"/>
                                <ItemsControl ItemsSource="{Binding IncomeStatement.Expenses}" ItemTemplate="{StaticResource StatementLineTemplate}"/>
                                <DockPanel Margin="0,4,0,12">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IncomeStatement.TotalExpenses, StringFormat=N2}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource erp.totalExpenses}" FontWeight="SemiBold"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IncomeStatement.GrossMargin, StringFormat=N2}"/>
                                    <TextBlock Text="{DynamicResource erp.grossMargin}"/>
                                </DockPanel>
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding IncomeStatement.NetResult, StringFormat=N2}" Style="{StaticResource Text.Kpi}"/>
                                        <TextBlock Text="{DynamicResource erp.netResult}" Style="{StaticResource Text.Section}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Balance sheet -->
                    <TabItem Header="{DynamicResource erp.balanceSheet}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource erp.assets}" Style="{StaticResource Text.Section}"/>
                                    <ItemsControl ItemsSource="{Binding BalanceSheet.Assets}" ItemTemplate="{StaticResource StatementLineTemplate}"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceSheet.TotalAssets, StringFormat=N2}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource erp.total}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource erp.liabilities}" Style="{StaticResource Text.Section}"/>
                                    <ItemsControl ItemsSource="{Binding BalanceSheet.Liabilities}" ItemTemplate="{StaticResource StatementLineTemplate}"/>
                                    <TextBlock Text="{DynamicResource erp.equity}" Style="{StaticResource Text.Section}" Margin="0,12,0,0"/>
                                    <ItemsControl ItemsSource="{Binding BalanceSheet.Equity}" ItemTemplate="{StaticResource StatementLineTemplate}"/>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceSheet.CurrentResult, StringFormat=N2}"/>
                                        <TextBlock Text="{DynamicResource erp.currentResult}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold">
                                            <Run Text="{Binding BalanceSheet.TotalLiabilities, Mode=OneWay, StringFormat=N2}"/> + <Run Text="{Binding BalanceSheet.TotalEquity, Mode=OneWay, StringFormat=N2}"/>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource erp.total}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource erp.unbalancedWarning}" Style="{StaticResource Text.Error}" Margin="0,8,0,0"
                                               Visibility="{Binding BalanceSheet.IsBalanced, Converter={StaticResource InvBoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Period lock -->
                    <TabItem Header="{DynamicResource erp.periods}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox Text="{Binding PeriodYear}" Width="70" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource erp.year}"/>
                                <ComboBox ItemsSource="{x:Static vm:AccountingViewModel.Months}" SelectedItem="{Binding PeriodMonth}" Width="70" Margin="8,0,0,0"
                                          AutomationProperties.Name="{DynamicResource erp.month}"/>
                                <Button Content="{DynamicResource erp.closePeriod}" Command="{Binding ClosePeriodCommand}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0"/>
                                <Button Content="{DynamicResource erp.reopenPeriod}" Command="{Binding ReopenPeriodCommand}" Margin="8,0,0,0"/>
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding FormError}" Style="{StaticResource Text.Error}" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource erp.periodsHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Periods}" IsReadOnly="True" AutoGenerateColumns="False" MaxWidth="400" HorizontalAlignment="Left">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource erp.period}" Binding="{Binding Period}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="{DynamicResource erp.closed}" Binding="{Binding Closed}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
                <Grid Margin="0,48,0,0" IsHitTestVisible="{Binding IsReady, Converter={StaticResource Not}}">
                    <c:PageState/>
                </Grid>
            </Grid>

            <!-- Manual journal entry -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="560" Margin="16,0,0,0" Visibility="{Binding Editor, Converter={StaticResource NotNullToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource erp.manualEntry}" Style="{StaticResource Text.Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource erp.date}" Style="{StaticResource Text.Label}"/>
                                <DatePicker SelectedDate="{Binding Editor.Date}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource erp.description}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding Editor.Description}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Editor.Lines}" SelectedItem="{Binding Editor.SelectedLine}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Margin="0,10,0,0" MinHeight="140">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource erp.account}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Account, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Text"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource erp.debit}" Binding="{Binding Debit, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="{DynamicResource erp.credit}" Binding="{Binding Credit, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="{DynamicResource erp.description}" Binding="{Binding Description}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="{DynamicResource action.add}" Command="{Binding Editor.AddLineCommand}" Style="{StaticResource Button.Ghost}"/>
                            <Button Content="{DynamicResource erp.removeLine}" Command="{Binding Editor.RemoveLineCommand}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource erp.debit}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Editor.TotalDebit, StringFormat=N2}"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource erp.credit}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Editor.TotalCredit, StringFormat=N2}"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource erp.difference}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Editor.Difference, StringFormat=N2}" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource erp.unbalancedWarning}" Style="{StaticResource Text.Error}" Margin="0,6,0,0"
                                   Visibility="{Binding Editor.IsBalanced, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource erp.post}" Command="{Binding SaveEntryCommand}" Style="{StaticResource Button.Primary}"
                                    IsEnabled="{Binding Editor.IsBalanced}"/>
                            <Button Content="{DynamicResource action.cancel}" Command="{Binding CancelEntryCommand}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
