<UserControl x:Class="Veltrix.Desktop.Views.Erp.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource erp.nav.hr}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="{DynamicResource erp.activeOnly}" IsChecked="{Binding ActiveOnly}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="{DynamicResource action.search}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchNowCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource action.new}" Command="{Binding NewCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"/>
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource erp.payrollDisclaimer}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TabControl SelectedIndex="{Binding TabIndex}">
            <!-- Employees -->
            <TabItem Header="{DynamicResource erp.employees}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <DockPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource erp.monthlyPayroll}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding MonthlyPayroll, StringFormat=N2}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Code}" Width="70"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.name}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.role}" Binding="{Binding Role}" Width="140"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.hireDate}" Binding="{Binding HireDate}" Width="100"/>
                                    <DataGridCheckBoxColumn Header="{DynamicResource erp.active}" Binding="{Binding IsActive}" Width="70"/>
                                    <DataGridTextColumn Header="{DynamicResource erp.salary}" Binding="{Binding Salary, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Cell.Number}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <c:PageState/>
                    </Grid>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding Editor, Converter={StaticResource NotNullToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel DataContext="{Binding Editor}">
                                    <TextBlock Text="{DynamicResource erp.employee}" Style="{StaticResource Text.Section}"/>
                                    <TextBlock Text="{DynamicResource erp.name}" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Name}"/>
                                    <TextBlock Text="{DynamicResource erp.role}" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Role}"/>
                                    <TextBlock Text="{DynamicResource erp.phone}" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Phone}" FlowDirection="LeftToRight"/>
                                    <TextBlock Text="{DynamicResource erp.monthlySalary}" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Salary}" FlowDirection="LeftToRight"/>
                                    <TextBlock Text="{DynamicResource erp.hireDate}" Style="{StaticResource Text.Label}"/>
                                    <DatePicker SelectedDate="{Binding HireDate}"/>
                                    <CheckBox Content="{DynamicResource erp.active}" IsChecked="{Binding IsActive}" Margin="0,10,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                                <Button Content="{DynamicResource action.save}" Style="{StaticResource Button.Primary}" Margin="0,12,0,0" Command="{Binding SaveCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Salary advances -->
            <TabItem Header="{DynamicResource erp.advances}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Advances}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Advance.Number}" Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource erp.date}" Binding="{Binding Advance.Date}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource erp.employee}" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource erp.method}" Binding="{Binding Advance.Method}" Width="70"/>
                            <DataGridTextColumn Header="{DynamicResource erp.amount}" Binding="{Binding Advance.Amount, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                            <DataGridCheckBoxColumn Header="{DynamicResource erp.deducted}" Binding="{Binding Advance.PayrollRunId, Converter={StaticResource NotNullToBool}, Mode=OneWay}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource erp.newAdvance}" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{DynamicResource erp.employee}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding AdvanceEmployee}" DisplayMemberPath="Name"/>
                            <TextBlock Text="{DynamicResource erp.amount}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding AdvanceAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource erp.method}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{x:Static vm:ErpPageViewModel.PayMethodsList}" SelectedItem="{Binding AdvanceMethod}"/>
                            <TextBlock Text="{DynamicResource erp.date}" Style="{StaticResource Text.Label}"/>
                            <DatePicker SelectedDate="{Binding AdvanceDate}"/>
                            <TextBlock Text="{Binding FormError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                            <Button Content="{DynamicResource erp.giveAdvance}" Command="{Binding GiveAdvanceCommand}" Style="{StaticResource Button.Primary}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Payroll -->
            <TabItem Header="{DynamicResource erp.payroll}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox Text="{Binding RunYear}" Width="70" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource erp.year}"/>
                        <ComboBox ItemsSource="{x:Static vm:EmployeesViewModel.Months}" SelectedItem="{Binding RunMonth}" Width="70" Margin="8,0,0,0"
                                  AutomationProperties.Name="{DynamicResource erp.month}"/>
                        <Button Content="{DynamicResource erp.runPayroll}" Command="{Binding RunPayrollCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,24,0"/>
                        <ComboBox ItemsSource="{x:Static vm:ErpPageViewModel.PayMethodsList}" SelectedItem="{Binding PayMethod}" Width="90"
                                  AutomationProperties.Name="{DynamicResource erp.method}" IsEnabled="{Binding CanPay}"/>
                        <DatePicker SelectedDate="{Binding PayDate}" Width="130" Margin="8,0,0,0" IsEnabled="{Binding CanPay}"/>
                        <Button Content="{DynamicResource erp.paySalaries}" Command="{Binding PayRunCommand}" IsEnabled="{Binding CanPay}" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding FormError}" Style="{StaticResource Text.Error}" Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="110"/>
                                <DataGridTextColumn Header="{DynamicResource erp.year}" Binding="{Binding Year}" Width="60"/>
                                <DataGridTextColumn Header="{DynamicResource erp.month}" Binding="{Binding Month}" Width="50"/>
                                <DataGridTextColumn Header="{DynamicResource erp.gross}" Binding="{Binding TotalGross, StringFormat=N2}" Width="*" ElementStyle="{StaticResource Cell.Number}"/>
                                <DataGridTextColumn Header="{DynamicResource erp.advances}" Binding="{Binding TotalAdvances, StringFormat=N2}" Width="*" ElementStyle="{StaticResource Cell.Number}"/>
                                <DataGridTextColumn Header="{DynamicResource erp.net}" Binding="{Binding TotalNet, StringFormat=N2}" Width="*" ElementStyle="{StaticResource Cell.Number}"/>
                                <DataGridTextColumn Header="{DynamicResource erp.status}" Binding="{Binding Status}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="2" ItemsSource="{Binding Payslips}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource erp.employee}" Binding="{Binding EmployeeName}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource erp.gross}" Binding="{Binding Gross, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Cell.Number}"/>
                                <DataGridTextColumn Header="{DynamicResource erp.advances}" Binding="{Binding Advances, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Cell.Number}"/>
                                <DataGridTextColumn Header="{DynamicResource erp.net}" Binding="{Binding Net, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Cell.Number}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
