<UserControl x:Class="Veltrix.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource nav.inventory}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name" MinWidth="170"
                          ToolTip="{DynamicResource nav.warehouses}"/>
                <CheckBox Content="{DynamicResource dk.inv.inStock}" IsChecked="{Binding InStockOnly}" Margin="12,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="{DynamicResource action.search}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchNowCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <DockPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="‹" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPrevious}" MinWidth="40"/>
                        <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource Text.Caption}"/>
                        <Button Content="›" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNext}" MinWidth="40"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource cat.sku}" Binding="{Binding Sku}" Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource cat.name}" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource nav.warehouses}" Binding="{Binding WarehouseName}" Width="130"/>
                            <DataGridTextColumn Header="{DynamicResource inv.onHand}" Binding="{Binding Quantity, StringFormat={}{0:#,##0.###}}" Width="90" ElementStyle="{StaticResource Cell.Number}"/>
                            <DataGridTextColumn Header="{DynamicResource inv.available}" Binding="{Binding Available, StringFormat={}{0:#,##0.###}}" Width="90" ElementStyle="{StaticResource Cell.Number}"/>
                            <DataGridTextColumn Header="{DynamicResource inv.valuation}" Binding="{Binding Value, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <c:PageState/>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Visibility="{Binding Selected, Converter={StaticResource NotNullToVis}}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource inv.adjust}" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{Binding Selected.ProductName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Selected.WarehouseName}" Style="{StaticResource Text.Caption}"/>
                            <StackPanel Visibility="{Binding CanAdjust, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource dk.inv.adjustQty}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding AdjustQuantity, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                <TextBlock Text="{DynamicResource dk.inv.reason}" Style="{StaticResource Text.Label}"/>
                                <ComboBox ItemsSource="{x:Static vm:InventoryViewModel.Reasons}" SelectedItem="{Binding AdjustReason}"/>
                                <TextBlock Text="{DynamicResource dk.notes}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding AdjustNotes}"/>
                                <Button Content="{DynamicResource action.save}" Command="{Binding AdjustCommand}" Style="{StaticResource Button.Primary}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource inv.lowStock}" Style="{StaticResource Text.Section}"/>
                            <ItemsControl ItemsSource="{Binding LowStock}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.warning}">
                                                    <Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.###}}"/> / <Run Text="{Binding Threshold, Mode=OneWay, StringFormat={}{0:0.###}}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding WarehouseName}" Style="{StaticResource Text.Caption}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource state.empty}" Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding LowStock.Count, Converter={StaticResource EqualsZeroToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
