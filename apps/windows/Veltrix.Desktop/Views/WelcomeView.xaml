<UserControl x:Class="Veltrix.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- First run: language → privacy. The device binding already happened automatically; next is the local owner account. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Brush.Hero}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <Viewbox Width="180" Height="180">
                    <Canvas Width="512" Height="512">
                        <Path Data="{StaticResource Logo.LeftBlade}" Fill="{StaticResource Brush.BladeLeft}"/>
                        <Path Data="{StaticResource Logo.RightBlade}" Fill="{StaticResource Brush.BladeRight}"/>
                        <Ellipse Canvas.Left="286" Canvas.Top="370" Width="28" Height="28" Fill="#E6E9F0"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="VELTRIX OS" FontSize="30" FontWeight="SemiBold" Foreground="#F2F4F8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="{DynamicResource app.slogan}" Foreground="#ABB2C0" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="460" Margin="40" VerticalAlignment="Center">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding Language}" AutomationProperties.Name="{DynamicResource onb.language}"/>
                    <TextBlock Text="{DynamicResource onb.welcome}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource dk.activation.subtitle}" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,8,0,16" TextWrapping="Wrap"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource onb.privacyTitle}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{DynamicResource onb.privacyBody}" Style="{StaticResource Text.Caption}" FontSize="13"/>
                        <CheckBox Content="{DynamicResource onb.accept}" IsChecked="{Binding PrivacyAccepted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}"/>
                <Button Content="{DynamicResource dk.bind.continue}" Command="{Binding ContinueCommand}" Style="{StaticResource Button.Primary}" MinHeight="44" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
