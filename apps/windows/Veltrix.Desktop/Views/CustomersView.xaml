<UserControl x:Class="Veltrix.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource nav.customers}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="260" AutomationProperties.Name="{DynamicResource action.search}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchNowCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource action.new}" Command="{Binding NewCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HeaderedContentControl>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <DockPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="‹" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPrevious}" MinWidth="40"/>
                        <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource Text.Caption}"/>
                        <Button Content="›" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNext}" MinWidth="40"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource cat.name}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource crm.phone}" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="{DynamicResource crm.balance}" Binding="{Binding Balance, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                            <DataGridTextColumn Header="{DynamicResource crm.loyalty}" Binding="{Binding LoyaltyPoints, StringFormat={}{0:0.##}}" Width="90" ElementStyle="{StaticResource Cell.Number}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <c:PageState/>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding Editor, Converter={StaticResource NotNullToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Editor}">
                            <TextBlock Text="{DynamicResource action.edit}" Style="{StaticResource Text.Section}"/>
                            <ComboBox ItemsSource="{x:Static vm:CustomerEditor.Types}" SelectedItem="{Binding Type}"/>
                            <TextBlock Text="{DynamicResource cat.name}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Name}"/>
                            <TextBlock Text="{DynamicResource crm.phone}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Phone}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource auth.email}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Email}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource onb.address}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Address}"/>
                            <TextBlock Text="{DynamicResource dk.city}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding City}"/>
                            <TextBlock Text="{DynamicResource onb.wilaya}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Wilaya}"/>
                            <TextBlock Text="{DynamicResource onb.taxId}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding TaxId}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource crm.creditLimit}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding CreditLimit}" FlowDirection="LeftToRight"/>
                            <CheckBox Content="{DynamicResource crm.consent}" IsChecked="{Binding MarketingConsent}" Margin="0,10,0,0"/>
                            <TextBlock Text="{DynamicResource dk.notes}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Notes}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                        </StackPanel>
                        <Button Content="{DynamicResource action.save}" Style="{StaticResource Button.Primary}" Margin="0,16,0,0" Command="{Binding SaveCommand}"
                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource dk.customers.history}" Style="{StaticResource Text.Section}" Margin="0,20,0,4"/>
                        <ItemsControl ItemsSource="{Binding Purchases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}"/>
                                        <TextBlock Text="{Binding Date, StringFormat=d}" Style="{StaticResource Text.Caption}" Width="80" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Number}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
