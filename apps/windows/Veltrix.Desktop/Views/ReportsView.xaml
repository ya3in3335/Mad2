<UserControl x:Class="Veltrix.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls">
    <Grid>
        <DockPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource nav.reports}" Style="{StaticResource PageHeader}"/>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Title" MinWidth="240" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource rep.from}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Text.Caption}"/>
                    <DatePicker SelectedDate="{Binding From}" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="{DynamicResource rep.to}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Text.Caption}"/>
                    <DatePicker SelectedDate="{Binding To}" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                    <Button Content="{DynamicResource dk.rep.run}" Command="{Binding RunCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,12,0"/>
                    <Button Content="CSV" Command="{Binding ExportCommand}" CommandParameter="csv" Margin="0,0,6,0"/>
                    <Button Content="Excel" Command="{Binding ExportCommand}" CommandParameter="xlsx" Margin="0,0,6,0"/>
                    <Button Content="PDF" Command="{Binding ExportCommand}" CommandParameter="pdf"/>
                </WrapPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="{Binding RunError}" Style="{StaticResource Text.Error}" Margin="0,0,0,8"
                       Visibility="{Binding RunError, Converter={StaticResource NotNullToVis}}"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Summary}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0">
                            <TextBlock><Run Text="{Binding Key, Mode=OneWay}" Foreground="{DynamicResource Brush.textSecondary}"/>: <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid>
                <DataGrid ItemsSource="{Binding Table}" AutoGenerateColumns="True" Visibility="{Binding Table, Converter={StaticResource NotNullToVis}}"/>
                <TextBlock Text="{DynamicResource dk.rep.choose}" Style="{StaticResource Text.Caption}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Table, Converter={StaticResource NullToVis}}"/>
            </Grid>
        </DockPanel>
        <c:PageState/>
    </Grid>
</UserControl>
