<UserControl x:Class="Veltrix.Desktop.Views.PurchasingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource nav.purchasing}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="{DynamicResource sales.outstanding}" IsChecked="{Binding OutstandingOnly}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="{DynamicResource action.search}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchNowCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <TabControl SelectedIndex="{Binding TabIndex}">
            <TabItem Header="{DynamicResource nav.orders}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{DynamicResource dk.pur.submit}" Command="{Binding SubmitCommand}" Visibility="{Binding CanSubmitSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource action.approve}" Command="{Binding ApproveCommand}" Style="{StaticResource Button.Primary}"
                                Visibility="{Binding CanApproveSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource action.cancel}" Command="{Binding CancelOrderCommand}" Style="{StaticResource Button.Danger}"
                                Visibility="{Binding CanCancelSelected, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="130"/>
                                <DataGridTextColumn Header="{DynamicResource nav.suppliers}" Binding="{Binding SupplierName}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource rep.from}" Binding="{Binding OrderDate}" Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource lic.status}" Binding="{Binding Status}" Width="140"/>
                                <DataGridTextColumn Header="{DynamicResource pos.total}" Binding="{Binding Total, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Cell.Number}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <c:PageState/>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{DynamicResource nav.suppliers}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Suppliers}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource cat.name}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource crm.phone}" Binding="{Binding Phone}" Width="140"/>
                            <DataGridTextColumn Header="{DynamicResource crm.balance}" Binding="{Binding Balance, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Cell.Number}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:PageState/>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource sales.invoice}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Invoices}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="120"/>
                            <DataGridTextColumn Header="{DynamicResource nav.suppliers}" Binding="{Binding SupplierName}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource rep.from}" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource lic.status}" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn Header="{DynamicResource pos.total}" Binding="{Binding Total, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                            <DataGridTextColumn Header="{DynamicResource sales.outstanding}" Binding="{Binding Outstanding, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <c:PageState/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
