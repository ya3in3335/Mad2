<UserControl x:Class="Veltrix.Desktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource nav.sales}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="{DynamicResource action.search}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchNowCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="{DynamicResource action.search}" Command="{Binding SearchNowCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </HeaderedContentControl>
        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,12" Visibility="{Binding OfflineSales.Count, Converter={StaticResource NotNullToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource dk.sales.offlineQueue}" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding OfflineSales}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Caption}">
                                <Run Text="{Binding Number, Mode=OneWay}"/> · <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat=g}"/> ·
                                <Run Text="{Binding Total, Mode=OneWay, StringFormat=N2}"/> · <Run Text="{Binding Status, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TabControl SelectedIndex="{Binding TabIndex}">
            <TabItem Header="{DynamicResource dk.sales.documents}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{x:Static vm:SalesViewModel.DocumentTypes}" SelectedItem="{Binding DocumentType}" MinWidth="150"/>
                            <CheckBox Content="{DynamicResource sales.outstanding}" IsChecked="{Binding OutstandingOnly}" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="130"/>
                                    <DataGridTextColumn Header="{DynamicResource rep.from}" Binding="{Binding Date}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource pos.customer}" Binding="{Binding CustomerName}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource lic.status}" Binding="{Binding Status}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource pos.total}" Binding="{Binding Total, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                                    <DataGridTextColumn Header="{DynamicResource sales.outstanding}" Binding="{Binding Outstanding, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Cell.Number}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <c:PageState/>
                        </Grid>
                    </DockPanel>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding DocumentDetail, Converter={StaticResource NotNullToVis}}">
                        <DockPanel DataContext="{Binding DocumentDetail}">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{Binding Number}" Style="{StaticResource Text.Section}"/>
                                <TextBlock Text="{Binding CustomerName}"/>
                                <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Type, Mode=OneWay}"/> · <Run Text="{Binding Status, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal, StringFormat=N2}"/><TextBlock Text="{DynamicResource pos.subtotal}"/></DockPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TaxTotal, StringFormat=N2}"/><TextBlock Text="{DynamicResource pos.tax}"/></DockPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource pos.total}" FontWeight="SemiBold"/></DockPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Outstanding, StringFormat=N2}" Foreground="{DynamicResource Brush.warning}"/><TextBlock Text="{DynamicResource sales.outstanding}"/></DockPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotal, StringFormat=N2}"/>
                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###} ×}" Width="56" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource dk.sales.posReceipts}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{DynamicResource pos.reprint}" Command="{Binding ReprintCommand}" IsEnabled="{Binding SelectedReceipt, Converter={StaticResource NotNullToBool}}"/>
                        <Button Content="{DynamicResource cam.photo}" Command="{Binding ViewCameraPhotoCommand}" Margin="8,0,0,0"
                                IsEnabled="{Binding SelectedReceipt, Converter={StaticResource NotNullToBool}}"
                                Visibility="{Binding CamerasAvailable, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="160"/>
                                <DataGridTextColumn Header="{DynamicResource rep.from}" Binding="{Binding CreatedAt, StringFormat=g}" Width="150"/>
                                <DataGridTextColumn Header="{DynamicResource lic.status}" Binding="{Binding Status}" Width="110"/>
                                <DataGridCheckBoxColumn Header="{DynamicResource app.offline}" Binding="{Binding Offline}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource pos.total}" Binding="{Binding Total, StringFormat=N2}" Width="*" ElementStyle="{StaticResource Cell.Number}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <c:PageState/>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
