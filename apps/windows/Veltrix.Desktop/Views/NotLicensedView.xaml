<UserControl x:Class="Veltrix.Desktop.Views.NotLicensedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Device binding missing, copied or tampered: the app stops here and opens no data. -->
    <Grid>
        <Border Style="{StaticResource Card}" MaxWidth="560" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{DynamicResource dk.bind.title}" Style="{StaticResource Text.Title}" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource dk.bind.body}" Style="{StaticResource Text.Caption}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{DynamicResource dk.bind.contact}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,16,0,0" FlowDirection="LeftToRight">
                    <Run Text="{DynamicResource dk.bind.reference}"/>: <Run Text="{Binding Detail, Mode=OneWay}"/> · <Run Text="{Binding InstallationId, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
