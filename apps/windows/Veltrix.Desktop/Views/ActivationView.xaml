<UserControl x:Class="Veltrix.Desktop.Views.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <!-- Brand panel -->
        <Border Background="{StaticResource Brush.Hero}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <Viewbox Width="180" Height="180">
                    <Canvas Width="512" Height="512">
                        <Path Data="{StaticResource Logo.LeftBlade}" Fill="{StaticResource Brush.BladeLeft}"/>
                        <Path Data="{StaticResource Logo.RightBlade}" Fill="{StaticResource Brush.BladeRight}"/>
                        <Ellipse Canvas.Left="286" Canvas.Top="370" Width="28" Height="28" Fill="#00D9FF"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="VELTRIX OS" FontSize="30" FontWeight="SemiBold" Foreground="#F5F8FF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="{DynamicResource app.slogan}" Foreground="#A3B3CB" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="460" Margin="40" VerticalAlignment="Center">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding Language}" AutomationProperties.Name="{DynamicResource onb.language}"/>
                    <TextBlock Text="{DynamicResource onb.welcome}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource dk.activation.subtitle}" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,8,0,16"/>

                <Border Style="{StaticResource Banner}" Margin="0,0,0,12" Visibility="{Binding LicenseMessage, Converter={StaticResource NotNullToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource dk.check}" Command="{Binding CheckAgainCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding LicenseMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource onb.privacyTitle}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{DynamicResource onb.privacyBody}" Style="{StaticResource Text.Caption}" FontSize="13"/>
                        <CheckBox Content="{DynamicResource onb.accept}" IsChecked="{Binding PrivacyAccepted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource onb.server}" Style="{StaticResource Text.Label}" Margin="0,16,0,4"/>
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                         AutomationProperties.Name="{DynamicResource onb.server}"/>
                <TextBlock Text="{DynamicResource dk.activation.serverHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>

                <TextBlock Text="{DynamicResource onb.licenseKey}" Style="{StaticResource Text.Label}"/>
                <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontFamily="{StaticResource Font.Mono}"
                         CharacterCasing="Upper" AutomationProperties.Name="{DynamicResource onb.licenseKey}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ActivateCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}"/>

                <Grid Margin="0,20,0,0">
                    <Button Content="{DynamicResource onb.activate}" Command="{Binding ActivateCommand}" Style="{StaticResource Button.Primary}" MinHeight="44"
                            Visibility="{Binding Activated, Converter={StaticResource InvBoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding Activated, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.success}" StrokeThickness="3" Width="28" Height="28" Stretch="Uniform"/>
                        <TextBlock Text="{DynamicResource onb.activated}" Foreground="{DynamicResource Brush.success}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                    <ProgressBar IsIndeterminate="True"/>
                    <TextBlock Text="{DynamicResource onb.activating}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <!-- Offline activation: no server; the owner issues a device-bound activation code from the device code. -->
                <Expander Header="{DynamicResource dk.offline.title}" IsExpanded="{Binding ShowOffline}" Margin="0,20,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource dk.offline.notConfigured}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"
                                       Visibility="{Binding OfflineConfigured, Converter={StaticResource InvBoolToVis}}"/>
                            <TextBlock Text="{DynamicResource dk.offline.hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource dk.offline.deviceCode}" Style="{StaticResource Text.Label}" Margin="0,10,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource dk.offline.copy}" Command="{Binding CopyDeviceCodeCommand}" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding DeviceCode, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="{StaticResource Font.Mono}"
                                         TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource dk.offline.deviceCode}"/>
                            </DockPanel>
                            <TextBlock Text="{DynamicResource dk.offline.activationCode}" Style="{StaticResource Text.Label}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding ActivationCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontFamily="{StaticResource Font.Mono}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{DynamicResource dk.offline.activationCode}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{DynamicResource dk.offline.openFile}" Command="{Binding OpenActivationFileCommand}"/>
                                <Button Content="{DynamicResource dk.offline.activate}" Command="{Binding ActivateOfflineCommand}" Style="{StaticResource Button.Primary}"
                                        IsEnabled="{Binding OfflineConfigured}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>
                <TextBlock Text="{DynamicResource lic.recovery}" Style="{StaticResource Text.Caption}" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
