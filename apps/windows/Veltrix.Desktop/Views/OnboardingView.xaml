<UserControl x:Class="Veltrix.Desktop.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="40">
            <TextBlock Text="{DynamicResource onb.company}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource dk.onb.subtitle}" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,6,0,16"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource onb.companyName}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{DynamicResource onb.taxId}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding TaxId}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{DynamicResource onb.rc}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding TradeRegisterNo}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{DynamicResource crm.phone}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Phone}" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource onb.address}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Address}"/>
                        <TextBlock Text="{DynamicResource dk.city}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding City}"/>
                        <TextBlock Text="{DynamicResource onb.wilaya}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Wilaya}"/>
                        <TextBlock Text="{DynamicResource onb.currency}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Currency}" MaxLength="3" CharacterCasing="Upper" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Grid>
            </Border>
            <CheckBox Content="{DynamicResource onb.algeriaTax}" IsChecked="{Binding ApplyAlgeriaTaxTemplate}" Margin="0,12,0,0"/>
            <TextBlock Text="{DynamicResource acc.reviewNotice}" Style="{StaticResource Text.Caption}" Margin="24,2,0,0"/>

            <TextBlock Text="{DynamicResource onb.admin}" Style="{StaticResource Text.Section}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource onb.fullName}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding OwnerFullName}"/>
                        <TextBlock Text="{DynamicResource auth.email}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding OwnerEmail}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{DynamicResource onb.headOffice}" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding HeadOfficeName}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource auth.password}" Style="{StaticResource Text.Label}"/>
                        <PasswordBox x:Name="Password" PasswordChanged="OnPasswordChanged" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{DynamicResource dk.onb.passwordConfirm}" Style="{StaticResource Text.Label}"/>
                        <PasswordBox x:Name="PasswordConfirm" PasswordChanged="OnPasswordChanged" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{DynamicResource err.passwordPolicy}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}"/>
            <Button Content="{DynamicResource action.finish}" Command="{Binding CompleteCommand}" Style="{StaticResource Button.Primary}" MinHeight="44"
                    Margin="0,20,0,0" HorizontalAlignment="Right" MinWidth="200" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
            <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
