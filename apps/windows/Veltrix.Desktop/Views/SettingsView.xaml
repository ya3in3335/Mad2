<UserControl x:Class="Veltrix.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <HeaderedContentControl Header="{DynamicResource nav.settings}" Style="{StaticResource PageHeader}"/>
            <UniformGrid Columns="2">
                <!-- Appearance -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource set.language}" Style="{StaticResource Text.Section}"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Language}"/>
                        <TextBlock Text="{DynamicResource set.theme}" Style="{StaticResource Text.Label}" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource set.themeDark}" IsChecked="{Binding IsDarkTheme}" GroupName="theme"/>
                            <RadioButton Content="{DynamicResource set.themeLight}" IsChecked="{Binding IsDarkTheme, Converter={StaticResource Not}}" GroupName="theme"/>
                        </StackPanel>
                        <CheckBox Content="{DynamicResource set.reducedMotion}" IsChecked="{Binding ReducedMotion}" Margin="0,16,0,0"/>
                        <!-- Accent colour: round swatches, live preview (applied as soon as one is picked). -->
                        <TextBlock Text="{DynamicResource dk.accent.title}" Style="{StaticResource Text.Label}" Margin="0,16,0,2"/>
                        <TextBlock Text="{DynamicResource dk.accent.hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding AccentOptions}" SelectedValuePath="Code" SelectedValue="{Binding Accent}"
                                 AutomationProperties.Name="{DynamicResource dk.accent.title}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="ToolTip" Value="{Binding NameKey, Converter={StaticResource ResourceKey}}"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding NameKey, Converter={StaticResource ResourceKey}}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Width="40" Height="40" Background="Transparent">
                                                    <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="{DynamicResource Brush.textPrimary}" Opacity="0"/>
                                                    <Ellipse x:Name="Hover" StrokeThickness="2" Stroke="{DynamicResource Brush.borderStrong}" Opacity="0"/>
                                                    <Ellipse Margin="5">
                                                        <Ellipse.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="{Binding Start}" Offset="0"/>
                                                                <GradientStop Color="{Binding Mid}" Offset="0.5"/>
                                                                <GradientStop Color="{Binding End}" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Path x:Name="Check" Data="M5,10.5 L8.5,14 L15,6.5" Width="20" Height="20" Stretch="None"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{Binding OnAccent}"
                                                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="Stroke" Value="{DynamicResource Brush.focus}"/><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Style="{StaticResource Text.Caption}">
                            <Run Text="{DynamicResource dk.accent.selected}"/><Run Text=": "/><Run Text="{Binding Accent, Mode=OneWay, Converter={StaticResource ResourceKey}, ConverterParameter=dk.accent.}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Server (online mode) / printer -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource onb.server}" Style="{StaticResource Text.Section}"/>
                            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                            <Button Content="{DynamicResource action.save}" Command="{Binding SaveServerCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- CCTV (owner) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding CamerasAvailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource cam.nav}" Style="{StaticResource Text.Section}"/>
                        <CheckBox Content="{DynamicResource cam.set.snapshotOnSale}" IsChecked="{Binding SnapshotOnSale}" Style="{StaticResource Toggle.Switch}" Margin="0,8,0,0"/>
                        <TextBlock Text="{DynamicResource cam.set.retention}" Style="{StaticResource Text.Label}" Margin="0,12,0,6"/>
                        <TextBox Text="{Binding SnapshotRetentionDays, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Border>
                <!-- Sync (online mode) -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Visibility="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource action.sync}" Style="{StaticResource Text.Section}"/>
                        <TextBlock><Run Text="{DynamicResource sync.lastSync}"/>: <Run Text="{Binding LastSync, Mode=OneWay}"/></TextBlock>
                        <TextBlock Margin="0,4,0,0"><Run Text="{DynamicResource dk.set.pending}"/>: <Run Text="{Binding Pending, Mode=OneWay}"/></TextBlock>
                        <Button Content="{DynamicResource action.sync}" Command="{Binding SyncNowCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Type, Mode=OneWay}"/> · <Run Text="{Binding Status, Mode=OneWay}"/> · <Run Text="{Binding Attempts, Mode=OneWay}"/>×</TextBlock>
                                        <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Caption}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- License -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource nav.licensing}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{Binding LicenseStatus}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,6,0,0"><Run Text="{DynamicResource lic.plan}"/>: <Run Text="{Binding LicensePlan, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="{DynamicResource lic.expires}"/>: <Run Text="{Binding LicenseExpires, Mode=OneWay}"/></TextBlock>
                        <TextBlock Visibility="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}}"><Run Text="{DynamicResource lic.offlineUntil}"/>: <Run Text="{Binding OfflineUntil, Mode=OneWay}"/></TextBlock>
                        <TextBlock Visibility="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}}"><Run Text="{DynamicResource lic.seats}"/>: <Run Text="{Binding Seats, Mode=OneWay}"/></TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}}">
                            <Button Content="{DynamicResource dk.check}" Command="{Binding RenewLicenseCommand}" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource lic.release}" Command="{Binding ReleaseDeviceCommand}" Style="{StaticResource Button.Danger}"
                                    Visibility="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Standalone: local users (owner only) -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource dk.sa.users}" Style="{StaticResource Text.Section}"/>
                        <ItemsControl ItemsSource="{Binding LocalUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource action.delete}" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.RemoveLocalUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/> · <Run Text="{Binding Role, Mode=OneWay}"/></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource dk.sa.userName}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{DynamicResource auth.password}" Style="{StaticResource Text.Label}"/>
                            <PasswordBox x:Name="NewUserSecretBox" PasswordChanged="OnNewUserSecretChanged" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource dk.sa.secretRule}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding LocalRoleOptions}" SelectedItem="{Binding NewUserRole}" Margin="0,8,0,0"/>
                            <Button Content="{DynamicResource action.add}" Command="{Binding AddLocalUserCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Standalone: encrypted backup (owner only) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsStandalone, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource dk.sa.backup}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{DynamicResource dk.sa.backupHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                        <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource dk.sa.backupPasswordPrompt}" Style="{StaticResource Text.Label}"/>
                            <PasswordBox x:Name="BackupPasswordBox" PasswordChanged="OnBackupPasswordChanged" FlowDirection="LeftToRight"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{DynamicResource dk.sa.export}" Command="{Binding ExportBackupCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource dk.sa.restore}" Command="{Binding RestoreBackupCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{DynamicResource dk.sa.serverOnly}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Diagnostics -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource set.diagnostics}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{DynamicResource dk.set.diagnosticsHint}" Style="{StaticResource Text.Caption}"/>
                        <Button Content="{DynamicResource action.export}" Command="{Binding ExportDiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <!-- About -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="VELTRIX OS" Style="{StaticResource Text.Section}"/>
                        <TextBlock><Run Text="{DynamicResource app.version}"/>: <Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight" Margin="0,6,0,0">Installation: <Run Text="{Binding InstallationId, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight">Device: <Run Text="{Binding DeviceId, Mode=OneWay}"/></TextBlock>
                        <Button Content="{DynamicResource action.signOut}" Command="{Binding SignOutCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <!-- Receipt (ticket) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding Receipt}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource dk.rcpt.title}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{DynamicResource dk.rcpt.hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>

                        <TextBlock Text="{DynamicResource dk.rcpt.paper}" Style="{StaticResource Text.Label}" Margin="0,12,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="58 mm" GroupName="paper" IsChecked="{Binding PaperMm, Converter={StaticResource Equals}, ConverterParameter=58}" Margin="0,0,12,0"/>
                            <RadioButton Content="80 mm" GroupName="paper" IsChecked="{Binding PaperMm, Converter={StaticResource Equals}, ConverterParameter=80}" Margin="0,0,12,0"/>
                            <RadioButton Content="A4" GroupName="paper" IsChecked="{Binding PaperMm, Converter={StaticResource Equals}, ConverterParameter=210}"/>
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource dk.rcpt.margins}" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding MarginOptions}" SelectedItem="{Binding MarginMm}" ItemStringFormat="{}{0} mm"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource dk.rcpt.fontSize}" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding FontSizeOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding FontSize}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource dk.rcpt.copies}" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding CopyOptions}" SelectedItem="{Binding Copies}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dk.rcpt.language}" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Language}"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{DynamicResource dk.rcpt.header}" Style="{StaticResource Text.Section}" Margin="0,16,0,0"/>
                        <TextBlock Text="{DynamicResource dk.rcpt.logo}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource dk.rcpt.logoPick}" Command="{Binding PickLogoCommand}" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource dk.rcpt.logoRemove}" Command="{Binding RemoveLogoCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,0"
                                    Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{DynamicResource dk.rcpt.logoWidth}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                            <ComboBox ItemsSource="{Binding LogoWidthOptions}" SelectedItem="{Binding LogoMaxWidthMm}" ItemStringFormat="{}{0} mm" MinWidth="80"/>
                        </StackPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource dk.rcpt.shopName}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dk.rcpt.phone}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, Delay=400}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{DynamicResource dk.rcpt.address}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource dk.rcpt.nif}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Nif, UpdateSourceTrigger=PropertyChanged, Delay=400}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource dk.rcpt.rc}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Rc, UpdateSourceTrigger=PropertyChanged, Delay=400}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource dk.rcpt.nis}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Nis, UpdateSourceTrigger=PropertyChanged, Delay=400}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dk.rcpt.ai}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Ai, UpdateSourceTrigger=PropertyChanged, Delay=400}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{DynamicResource dk.rcpt.legalHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource dk.rcpt.headerLines}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding HeaderLines, UpdateSourceTrigger=PropertyChanged, Delay=400}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalContentAlignment="Top"/>

                        <TextBlock Text="{DynamicResource dk.rcpt.body}" Style="{StaticResource Text.Section}" Margin="0,16,0,0"/>
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource dk.rcpt.showSaleNumber}" IsChecked="{Binding ShowSaleNumber}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                                <CheckBox Content="{DynamicResource dk.rcpt.showDate}" IsChecked="{Binding ShowDate}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                                <CheckBox Content="{DynamicResource dk.rcpt.showCashier}" IsChecked="{Binding ShowCashier}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                                <CheckBox Content="{DynamicResource dk.rcpt.showCustomer}" IsChecked="{Binding ShowCustomer}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                                <CheckBox Content="{DynamicResource dk.rcpt.showItemCode}" IsChecked="{Binding ShowItemCode}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <CheckBox Content="{DynamicResource dk.rcpt.showUnitPrice}" IsChecked="{Binding ShowUnitPrice}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                                <CheckBox Content="{DynamicResource dk.rcpt.showDiscount}" IsChecked="{Binding ShowDiscount}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                                <CheckBox Content="{DynamicResource dk.rcpt.showTax}" IsChecked="{Binding ShowTax}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                                <CheckBox Content="{DynamicResource dk.rcpt.showPayments}" IsChecked="{Binding ShowPayments}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                                <CheckBox Content="{DynamicResource dk.rcpt.totalInWords}" IsChecked="{Binding TotalInWords}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{DynamicResource dk.rcpt.dateFormat}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                        <ComboBox ItemsSource="{Binding DateFormatOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding DateFormat}"
                                  FlowDirection="LeftToRight" HorizontalAlignment="Left" MinWidth="200"/>

                        <TextBlock Text="{DynamicResource dk.rcpt.footer}" Style="{StaticResource Text.Section}" Margin="0,16,0,0"/>
                        <TextBlock Text="{DynamicResource dk.rcpt.footerLines}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding FooterLines, UpdateSourceTrigger=PropertyChanged, Delay=400}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalContentAlignment="Top"/>
                        <CheckBox Content="{DynamicResource dk.rcpt.saleBarcode}" IsChecked="{Binding ShowSaleBarcode}" Style="{StaticResource Toggle.Switch}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="340">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource dk.rcpt.testPrint}" Command="{Binding TestPrintCommand}" Style="{StaticResource Button.Primary}"/>
                            <TextBlock Text="{DynamicResource dk.rcpt.preview}" Style="{StaticResource Text.Section}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Background="#E6E6E6" Padding="8" Margin="0,8,0,0" CornerRadius="4">
                            <FlowDocumentScrollViewer Document="{Binding Preview, Converter={StaticResource ReceiptPreview}}" Height="720"
                                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsToolBarVisible="True"
                                                      Background="#E6E6E6" FlowDirection="LeftToRight"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
