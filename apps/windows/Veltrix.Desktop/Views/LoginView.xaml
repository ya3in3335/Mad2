<UserControl x:Class="Veltrix.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Brush.Hero}">
        <Border x:Name="Card" Style="{StaticResource Card}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
            <Border.RenderTransform><TranslateTransform x:Name="Shake"/></Border.RenderTransform>
            <StackPanel>
                <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                    <Canvas Width="512" Height="512">
                        <Path Data="{StaticResource Logo.LeftBlade}" Fill="{StaticResource Brush.BladeLeft}"/>
                        <Path Data="{StaticResource Logo.RightBlade}" Fill="{StaticResource Brush.BladeRight}"/>
                        <Ellipse Canvas.Left="286" Canvas.Top="370" Width="28" Height="28" Fill="#00D9FF"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{DynamicResource auth.title}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="20"/>
                <TextBlock Text="{Binding TenantName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" FontSize="13" Margin="0,4,0,8"/>

                <Border Style="{StaticResource Banner}" Margin="0,8,0,0" Visibility="{Binding LicenseBanner, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="{Binding LicenseBanner}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="{DynamicResource auth.email}" Style="{StaticResource Text.Label}"/>
                <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                         AutomationProperties.Name="{DynamicResource auth.email}"/>
                <TextBlock Text="{DynamicResource auth.password}" Style="{StaticResource Text.Label}"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" FlowDirection="LeftToRight"
                             AutomationProperties.Name="{DynamicResource auth.password}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SignInCommand}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <StackPanel Visibility="{Binding MfaRequired, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource auth.mfaCode}" Style="{StaticResource Text.Label}"/>
                    <TextBox x:Name="MfaBox" Text="{Binding MfaCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MaxLength="8"
                             FontFamily="{StaticResource Font.Mono}" FontSize="18" AutomationProperties.Name="{DynamicResource auth.mfaCode}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SignInCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{DynamicResource dk.login.mfaPrompt}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}"/>
                <Button Content="{DynamicResource action.signIn}" Command="{Binding SignInCommand}" Style="{StaticResource Button.Primary}" MinHeight="44" Margin="0,20,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
                <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{DynamicResource auth.offlineLogin}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <Button Content="{DynamicResource dk.login.changeServer}" Command="{Binding ChangeServerCommand}" Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush.textSecondary}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
