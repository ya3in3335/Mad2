<UserControl x:Class="Veltrix.Desktop.Views.CamerasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Veltrix.Desktop.Controls">
    <DockPanel>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{DynamicResource cam.nav}" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource cam.layout}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Text.Caption}"/>
                <RadioButton Content="1" GroupName="camgrid" IsChecked="{Binding GridSize, Converter={StaticResource Equals}, ConverterParameter=1}" Margin="0,0,6,0"/>
                <RadioButton Content="2×2" GroupName="camgrid" IsChecked="{Binding GridSize, Converter={StaticResource Equals}, ConverterParameter=2}" Margin="0,0,6,0"/>
                <RadioButton Content="3×3" GroupName="camgrid" IsChecked="{Binding GridSize, Converter={StaticResource Equals}, ConverterParameter=3}" Margin="0,0,12,0"/>
                <Button Content="&#xE76B;" FontFamily="{StaticResource Font.Icons}" Style="{StaticResource Button.Icon}" Command="{Binding PreviousPageCommand}"
                        AutomationProperties.Name="Previous"/>
                <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="6,0" FlowDirection="LeftToRight"/>
                <Button Content="&#xE76C;" FontFamily="{StaticResource Font.Icons}" Style="{StaticResource Button.Icon}" Command="{Binding NextPageCommand}"
                        AutomationProperties.Name="Next" Margin="0,0,12,0"/>
                <Button Content="{DynamicResource cam.manage}" Command="{Binding ToggleManagementCommand}" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource cam.add}" Command="{Binding AddCommand}" Style="{StaticResource Button.Primary}"/>
            </StackPanel>
        </HeaderedContentControl>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource Text.Status}" Margin="0,8,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" TextWrapping="Wrap"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Live grid (sub streams). Double-click: full screen on the main stream. -->
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.GridSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Rows="{Binding DataContext.GridSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="3" CornerRadius="6" ClipToBounds="True" Background="Black">
                            <c:CameraTile Feed="{Binding Feed}" ShowSnapshotButton="True" DoubleClicked="Tile_DoubleClicked" SnapshotRequested="Tile_SnapshotRequested"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:PageState/>
            <!-- Camera management -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="400" Margin="12,0,0,0" Visibility="{Binding ShowManagement, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource cam.list}" Style="{StaticResource Text.Section}"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{DynamicResource cam.edit}" Command="{Binding EditCommand}" IsEnabled="{Binding SelectedCamera, Converter={StaticResource NotNullToBool}}"/>
                        <Button Content="{DynamicResource cam.delete}" Command="{Binding DeleteCommand}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0"
                                IsEnabled="{Binding SelectedCamera, Converter={StaticResource NotNullToBool}}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" IsReadOnly="True" MouseDoubleClick="Cameras_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource cam.name}" Binding="{Binding Camera.Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource cam.brand}" Binding="{Binding BrandText}" Width="80"/>
                            <DataGridTextColumn Header="{DynamicResource cam.host}" Binding="{Binding Address}" Width="120"/>
                            <DataGridCheckBoxColumn Header="{DynamicResource cam.cashier}" Binding="{Binding IsCashier}" Width="60"/>
                            <DataGridCheckBoxColumn Header="{DynamicResource cam.enabled}" Binding="{Binding Enabled}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
