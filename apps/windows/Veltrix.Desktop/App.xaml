<Application x:Class="Veltrix.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Veltrix.Desktop.Presentation.ViewModels;assembly=Veltrix.Desktop.Presentation"
             xmlns:erp="clr-namespace:Veltrix.Desktop.Views.Erp"
             xmlns:views="clr-namespace:Veltrix.Desktop.Views"
             xmlns:wf="clr-namespace:Veltrix.Desktop.Views.Workforce"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Order matters: theme colours (generated) + theme extras + accent palette (overrides both), then strings, then styles (last).
                 The theme and language dictionaries are swapped at runtime (WpfPlatformUi). -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Theme.Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Accents/Accent.Cyan.Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Localization/Strings.en.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Localization/Strings.Desktop.en.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Localization/Strings.Erp.en.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Localization/Strings.Workforce.en.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <!-- Top-level screens -->
            <DataTemplate DataType="{x:Type vm:NotLicensedViewModel}"><views:NotLicensedView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WelcomeViewModel}"><views:WelcomeView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OnboardingViewModel}"><views:OnboardingView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShellViewModel}"><views:ShellView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SuppliersViewModel}"><erp:SuppliersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchasesViewModel}"><erp:PurchasesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExpensesViewModel}"><erp:ExpensesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountingViewModel}"><erp:AccountingView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:EmployeesViewModel}"><erp:EmployeesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CashRegisterViewModel}"><erp:CashRegisterView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReceivablesViewModel}"><erp:ReceivablesView/></DataTemplate>
            <!-- Pages -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PosViewModel}"><views:PosView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}"><views:ProductsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><views:InventoryView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesViewModel}"><views:SalesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchasingViewModel}"><views:PurchasingView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CamerasViewModel}"><views:CamerasView/></DataTemplate>
            <!-- Workforce & attendance -->
            <DataTemplate DataType="{x:Type vm:WfDashboardViewModel}"><wf:WfDashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfEmployeesViewModel}"><wf:WfEmployeesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfKioskViewModel}"><wf:WfKioskView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfAttendanceViewModel}"><wf:WfAttendanceView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfLiveViewModel}"><wf:WfLiveView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfShiftPlannerViewModel}"><wf:WfShiftPlannerView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfLeaveViewModel}"><wf:WfLeaveView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfOvertimeViewModel}"><wf:WfOvertimeView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfAccessViewModel}"><wf:WfAccessView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfDevicesViewModel}"><wf:WfDevicesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfPayrollViewModel}"><wf:WfPayrollView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfReportsViewModel}"><wf:WfReportsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WfSettingsViewModel}"><wf:WfSettingsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
