<!-- Accent "Blue" for the Light theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#1D4ED8</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#1D4ED8"/>
    <Color x:Key="Color.primaryButton">#1D4ED8</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#1D4ED8"/>
    <Color x:Key="Color.accent">#1D4ED8</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#1D4ED8"/>
    <Color x:Key="Color.violet">#1E40AF</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#1E40AF"/>
    <Color x:Key="Color.focus">#1D4ED8</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#1D4ED8"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6F7FA" Offset="0"/><GradientStop Color="#ECEEF3" Offset="0.5"/><GradientStop Color="#E3E6ED" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1F1D4ED8" Offset="0"/><GradientStop Color="#001D4ED8" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#101D4ED8" Offset="0"/><GradientStop Color="#001D4ED8" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#591D4ED8" Offset="0"/>
        <GradientStop Color="#2E1E40AF" Offset="0.5"/>
        <GradientStop Color="#4D1D4ED8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#991D4ED8" Offset="0"/>
        <GradientStop Color="#731E40AF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#001D4ED8" Offset="0"/>
        <GradientStop Color="#991D4ED8" Offset="0.3"/>
        <GradientStop Color="#991E40AF" Offset="0.7"/>
        <GradientStop Color="#001E40AF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#661D4ED8"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#101D4ED8"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#241D4ED8"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1C1D4ED8"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#171D4ED8"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1C1E40AF"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#801D4ED8"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E1D4ED8" Offset="0"/>
        <GradientStop Color="#121E40AF" Offset="0.6"/>
        <GradientStop Color="#001E40AF" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="0.5"/>
        <GradientStop Color="#1E40AF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1D4ED8" Offset="0"/>
        <GradientStop Color="#1E40AF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1D25" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="0.6"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9F4F5F8" Offset="0.55"/>
        <GradientStop Color="#1F1D4ED8" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#1D4ED8" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.16"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#1D4ED8" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#1D4ED8" BlurRadius="8" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#4060A5FA"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#6660A5FA"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#593B82F6"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#60A5FA"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4D60A5FA" Offset="0"/><GradientStop Color="#0060A5FA" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#403B82F6" Offset="0"/><GradientStop Color="#003B82F6" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
