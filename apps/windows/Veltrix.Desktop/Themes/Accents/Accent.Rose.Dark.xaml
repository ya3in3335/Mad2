<!-- Accent "Rose" for the Dark theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#FB7185</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#FB7185"/>
    <Color x:Key="Color.primaryButton">#BE123C</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#BE123C"/>
    <Color x:Key="Color.accent">#FB7185</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#FB7185"/>
    <Color x:Key="Color.violet">#9F1239</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#9F1239"/>
    <Color x:Key="Color.focus">#FB7185</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#FB7185"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#26BE123C" Offset="0"/><GradientStop Color="#00BE123C" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#229F1239" Offset="0"/><GradientStop Color="#009F1239" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66E11D48" Offset="0"/>
        <GradientStop Color="#2EBE123C" Offset="0.5"/>
        <GradientStop Color="#559F1239" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99E11D48" Offset="0"/>
        <GradientStop Color="#669F1239" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E11D48" Offset="0"/>
        <GradientStop Color="#B3E11D48" Offset="0.3"/>
        <GradientStop Color="#B39F1239" Offset="0.7"/>
        <GradientStop Color="#009F1239" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#73FB7185"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#14FB7185"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#2EFB7185"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#24FB7185"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1FBE123C"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#269F1239"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#80FB7185"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#38BE123C" Offset="0"/>
        <GradientStop Color="#149F1239" Offset="0.6"/>
        <GradientStop Color="#009F1239" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E11D48" Offset="0"/>
        <GradientStop Color="#BE123C" Offset="0.5"/>
        <GradientStop Color="#9F1239" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E11D48" Offset="0"/>
        <GradientStop Color="#9F1239" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FB7185" Offset="0.55"/>
        <GradientStop Color="#E11D48" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EBE123C" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#249F1239" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#BE123C" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#BE123C" BlurRadius="20" ShadowDepth="0" Direction="270" Opacity="0.65"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#FB7185" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#40FB7185"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#66FB7185"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#599F1239"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#FB7185"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DBE123C" Offset="0"/><GradientStop Color="#00BE123C" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#409F1239" Offset="0"/><GradientStop Color="#009F1239" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
