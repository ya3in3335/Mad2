<!-- Accent "Aurora" for the Light theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#6D28D9</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#6D28D9"/>
    <Color x:Key="Color.primaryButton">#6D28D9</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#6D28D9"/>
    <Color x:Key="Color.accent">#6D28D9</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#6D28D9"/>
    <Color x:Key="Color.violet">#BE185D</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#BE185D"/>
    <Color x:Key="Color.focus">#6D28D9</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#6D28D9"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6F7FA" Offset="0"/><GradientStop Color="#ECEEF3" Offset="0.5"/><GradientStop Color="#E3E6ED" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1F6D28D9" Offset="0"/><GradientStop Color="#006D28D9" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#106D28D9" Offset="0"/><GradientStop Color="#006D28D9" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#596D28D9" Offset="0"/>
        <GradientStop Color="#2EBE185D" Offset="0.5"/>
        <GradientStop Color="#4D6D28D9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#996D28D9" Offset="0"/>
        <GradientStop Color="#73BE185D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#006D28D9" Offset="0"/>
        <GradientStop Color="#996D28D9" Offset="0.3"/>
        <GradientStop Color="#99BE185D" Offset="0.7"/>
        <GradientStop Color="#00BE185D" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#666D28D9"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#106D28D9"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#246D28D9"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1C6D28D9"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#176D28D9"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1CBE185D"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#806D28D9"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E6D28D9" Offset="0"/>
        <GradientStop Color="#12BE185D" Offset="0.6"/>
        <GradientStop Color="#00BE185D" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E7490" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="0.5"/>
        <GradientStop Color="#BE185D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6D28D9" Offset="0"/>
        <GradientStop Color="#BE185D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1D25" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="0.6"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9F4F5F8" Offset="0.55"/>
        <GradientStop Color="#1F6D28D9" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#6D28D9" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.16"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#6D28D9" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#6D28D9" BlurRadius="8" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#4067E8F9"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#6667E8F9"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#59F472B6"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#67E8F9"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DA78BFA" Offset="0"/><GradientStop Color="#00A78BFA" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#40F472B6" Offset="0"/><GradientStop Color="#00F472B6" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
