<!-- Accent "Cyan" for the Dark theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#22D3EE</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#22D3EE"/>
    <Color x:Key="Color.primaryButton">#22D3EE</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#22D3EE"/>
    <Color x:Key="Color.accent">#22D3EE</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#22D3EE"/>
    <Color x:Key="Color.violet">#06B6D4</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#06B6D4"/>
    <Color x:Key="Color.focus">#22D3EE</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#22D3EE"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#2622D3EE" Offset="0"/><GradientStop Color="#0022D3EE" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#2206B6D4" Offset="0"/><GradientStop Color="#0006B6D4" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66A5F3FC" Offset="0"/>
        <GradientStop Color="#2E22D3EE" Offset="0.5"/>
        <GradientStop Color="#5506B6D4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99A5F3FC" Offset="0"/>
        <GradientStop Color="#6606B6D4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00A5F3FC" Offset="0"/>
        <GradientStop Color="#B3A5F3FC" Offset="0.3"/>
        <GradientStop Color="#B306B6D4" Offset="0.7"/>
        <GradientStop Color="#0006B6D4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#7322D3EE"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#1422D3EE"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#2E22D3EE"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#2422D3EE"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1F22D3EE"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#2606B6D4"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#8022D3EE"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3822D3EE" Offset="0"/>
        <GradientStop Color="#1406B6D4" Offset="0.6"/>
        <GradientStop Color="#0006B6D4" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#0A0B10"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A5F3FC" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="0.5"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A5F3FC" Offset="0"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="0.55"/>
        <GradientStop Color="#A5F3FC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E22D3EE" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#2406B6D4" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#22D3EE" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#22D3EE" BlurRadius="20" ShadowDepth="0" Direction="270" Opacity="0.65"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#22D3EE" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#4022D3EE"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#6622D3EE"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#5906B6D4"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#22D3EE"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4D22D3EE" Offset="0"/><GradientStop Color="#0022D3EE" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#4006B6D4" Offset="0"/><GradientStop Color="#0006B6D4" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
