<!-- Accent "Orange" for the Light theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#C2410C</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#C2410C"/>
    <Color x:Key="Color.primaryButton">#9A3412</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#9A3412"/>
    <Color x:Key="Color.accent">#C2410C</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#C2410C"/>
    <Color x:Key="Color.violet">#7C2D12</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#7C2D12"/>
    <Color x:Key="Color.focus">#C2410C</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#C2410C"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6F7FA" Offset="0"/><GradientStop Color="#ECEEF3" Offset="0.5"/><GradientStop Color="#E3E6ED" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1F9A3412" Offset="0"/><GradientStop Color="#009A3412" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#10C2410C" Offset="0"/><GradientStop Color="#00C2410C" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#599A3412" Offset="0"/>
        <GradientStop Color="#2E7C2D12" Offset="0.5"/>
        <GradientStop Color="#4DC2410C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99C2410C" Offset="0"/>
        <GradientStop Color="#737C2D12" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#009A3412" Offset="0"/>
        <GradientStop Color="#999A3412" Offset="0.3"/>
        <GradientStop Color="#997C2D12" Offset="0.7"/>
        <GradientStop Color="#007C2D12" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#66C2410C"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#10C2410C"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#24C2410C"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1CC2410C"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#179A3412"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1C7C2D12"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#80C2410C"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E9A3412" Offset="0"/>
        <GradientStop Color="#127C2D12" Offset="0.6"/>
        <GradientStop Color="#007C2D12" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C2410C" Offset="0"/>
        <GradientStop Color="#9A3412" Offset="0.5"/>
        <GradientStop Color="#7C2D12" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C2410C" Offset="0"/>
        <GradientStop Color="#7C2D12" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1D25" Offset="0"/>
        <GradientStop Color="#C2410C" Offset="0.6"/>
        <GradientStop Color="#C2410C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9F4F5F8" Offset="0.55"/>
        <GradientStop Color="#1F9A3412" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#C2410C" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.16"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#9A3412" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#C2410C" BlurRadius="8" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#40FB923C"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#66FB923C"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#59F97316"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#FB923C"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DFB923C" Offset="0"/><GradientStop Color="#00FB923C" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#40F97316" Offset="0"/><GradientStop Color="#00F97316" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
