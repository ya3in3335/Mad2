<!-- Accent "Violet" for the Dark theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#A78BFA</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#A78BFA"/>
    <Color x:Key="Color.primaryButton">#6D28D9</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#6D28D9"/>
    <Color x:Key="Color.accent">#A78BFA</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#A78BFA"/>
    <Color x:Key="Color.violet">#5B21B6</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#5B21B6"/>
    <Color x:Key="Color.focus">#A78BFA</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#A78BFA"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#266D28D9" Offset="0"/><GradientStop Color="#006D28D9" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#225B21B6" Offset="0"/><GradientStop Color="#005B21B6" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#667C3AED" Offset="0"/>
        <GradientStop Color="#2E6D28D9" Offset="0.5"/>
        <GradientStop Color="#555B21B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#997C3AED" Offset="0"/>
        <GradientStop Color="#665B21B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#007C3AED" Offset="0"/>
        <GradientStop Color="#B37C3AED" Offset="0.3"/>
        <GradientStop Color="#B35B21B6" Offset="0.7"/>
        <GradientStop Color="#005B21B6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#73A78BFA"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#14A78BFA"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#2EA78BFA"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#24A78BFA"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1F6D28D9"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#265B21B6"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#80A78BFA"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#386D28D9" Offset="0"/>
        <GradientStop Color="#145B21B6" Offset="0.6"/>
        <GradientStop Color="#005B21B6" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="0.5"/>
        <GradientStop Color="#5B21B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#5B21B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#A78BFA" Offset="0.55"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E6D28D9" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#245B21B6" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#6D28D9" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#6D28D9" BlurRadius="20" ShadowDepth="0" Direction="270" Opacity="0.65"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#A78BFA" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#40A78BFA"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#66A78BFA"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#595B21B6"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#A78BFA"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4D6D28D9" Offset="0"/><GradientStop Color="#006D28D9" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#405B21B6" Offset="0"/><GradientStop Color="#005B21B6" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
