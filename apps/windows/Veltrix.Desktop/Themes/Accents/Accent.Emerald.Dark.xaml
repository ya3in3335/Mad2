<!-- Accent "Emerald" for the Dark theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#34D399</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#34D399"/>
    <Color x:Key="Color.primaryButton">#34D399</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#34D399"/>
    <Color x:Key="Color.accent">#34D399</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#34D399"/>
    <Color x:Key="Color.violet">#10B981</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#10B981"/>
    <Color x:Key="Color.focus">#34D399</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#34D399"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#2634D399" Offset="0"/><GradientStop Color="#0034D399" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#2210B981" Offset="0"/><GradientStop Color="#0010B981" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#666EE7B7" Offset="0"/>
        <GradientStop Color="#2E34D399" Offset="0.5"/>
        <GradientStop Color="#5510B981" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#996EE7B7" Offset="0"/>
        <GradientStop Color="#6610B981" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#006EE7B7" Offset="0"/>
        <GradientStop Color="#B36EE7B7" Offset="0.3"/>
        <GradientStop Color="#B310B981" Offset="0.7"/>
        <GradientStop Color="#0010B981" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#7334D399"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#1434D399"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#2E34D399"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#2434D399"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1F34D399"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#2610B981"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#8034D399"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3834D399" Offset="0"/>
        <GradientStop Color="#1410B981" Offset="0.6"/>
        <GradientStop Color="#0010B981" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#0A0B10"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6EE7B7" Offset="0"/>
        <GradientStop Color="#34D399" Offset="0.5"/>
        <GradientStop Color="#10B981" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6EE7B7" Offset="0"/>
        <GradientStop Color="#10B981" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#34D399" Offset="0.55"/>
        <GradientStop Color="#6EE7B7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E34D399" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#2410B981" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#34D399" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#34D399" BlurRadius="20" ShadowDepth="0" Direction="270" Opacity="0.65"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#34D399" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#4034D399"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#6634D399"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#5910B981"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#34D399"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4D34D399" Offset="0"/><GradientStop Color="#0034D399" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#4010B981" Offset="0"/><GradientStop Color="#0010B981" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
