<!-- Accent "Aurora" for the Dark theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#67E8F9</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#67E8F9"/>
    <Color x:Key="Color.primaryButton">#A78BFA</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#A78BFA"/>
    <Color x:Key="Color.accent">#67E8F9</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#67E8F9"/>
    <Color x:Key="Color.violet">#F472B6</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#F472B6"/>
    <Color x:Key="Color.focus">#67E8F9</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#67E8F9"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#26A78BFA" Offset="0"/><GradientStop Color="#00A78BFA" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#22F472B6" Offset="0"/><GradientStop Color="#00F472B6" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6622D3EE" Offset="0"/>
        <GradientStop Color="#2EA78BFA" Offset="0.5"/>
        <GradientStop Color="#55F472B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9922D3EE" Offset="0"/>
        <GradientStop Color="#66F472B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0022D3EE" Offset="0"/>
        <GradientStop Color="#B322D3EE" Offset="0.3"/>
        <GradientStop Color="#B3F472B6" Offset="0.7"/>
        <GradientStop Color="#00F472B6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#7367E8F9"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#1467E8F9"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#2E67E8F9"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#2467E8F9"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1FA78BFA"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#26F472B6"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#8067E8F9"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#38A78BFA" Offset="0"/>
        <GradientStop Color="#14F472B6" Offset="0.6"/>
        <GradientStop Color="#00F472B6" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#0A0B10"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#A78BFA" Offset="0.5"/>
        <GradientStop Color="#F472B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#F472B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#67E8F9" Offset="0.55"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EA78BFA" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#24F472B6" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#A78BFA" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#A78BFA" BlurRadius="20" ShadowDepth="0" Direction="270" Opacity="0.65"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#67E8F9" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#4067E8F9"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#6667E8F9"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#59F472B6"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#67E8F9"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DA78BFA" Offset="0"/><GradientStop Color="#00A78BFA" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#40F472B6" Offset="0"/><GradientStop Color="#00F472B6" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
