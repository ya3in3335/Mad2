<!-- Accent "Magenta" for the Dark theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#E879F9</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#E879F9"/>
    <Color x:Key="Color.primaryButton">#A21CAF</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#A21CAF"/>
    <Color x:Key="Color.accent">#E879F9</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#E879F9"/>
    <Color x:Key="Color.violet">#86198F</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#86198F"/>
    <Color x:Key="Color.focus">#E879F9</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#E879F9"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#26A21CAF" Offset="0"/><GradientStop Color="#00A21CAF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#2286198F" Offset="0"/><GradientStop Color="#0086198F" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66C026D3" Offset="0"/>
        <GradientStop Color="#2EA21CAF" Offset="0.5"/>
        <GradientStop Color="#5586198F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99C026D3" Offset="0"/>
        <GradientStop Color="#6686198F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00C026D3" Offset="0"/>
        <GradientStop Color="#B3C026D3" Offset="0.3"/>
        <GradientStop Color="#B386198F" Offset="0.7"/>
        <GradientStop Color="#0086198F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#73E879F9"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#14E879F9"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#2EE879F9"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#24E879F9"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1FA21CAF"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#2686198F"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#80E879F9"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#38A21CAF" Offset="0"/>
        <GradientStop Color="#1486198F" Offset="0.6"/>
        <GradientStop Color="#0086198F" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C026D3" Offset="0"/>
        <GradientStop Color="#A21CAF" Offset="0.5"/>
        <GradientStop Color="#86198F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C026D3" Offset="0"/>
        <GradientStop Color="#86198F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E879F9" Offset="0.55"/>
        <GradientStop Color="#C026D3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EA21CAF" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#2486198F" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#A21CAF" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#A21CAF" BlurRadius="20" ShadowDepth="0" Direction="270" Opacity="0.65"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#E879F9" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#40E879F9"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#66E879F9"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#5986198F"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#E879F9"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DA21CAF" Offset="0"/><GradientStop Color="#00A21CAF" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#4086198F" Offset="0"/><GradientStop Color="#0086198F" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
