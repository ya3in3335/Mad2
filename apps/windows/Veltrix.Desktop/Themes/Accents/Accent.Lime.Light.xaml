<!-- Accent "Lime" for the Light theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#3F6212</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#3F6212"/>
    <Color x:Key="Color.primaryButton">#A3E635</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#A3E635"/>
    <Color x:Key="Color.accent">#3F6212</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#3F6212"/>
    <Color x:Key="Color.violet">#84CC16</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#84CC16"/>
    <Color x:Key="Color.focus">#3F6212</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#3F6212"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6F7FA" Offset="0"/><GradientStop Color="#ECEEF3" Offset="0.5"/><GradientStop Color="#E3E6ED" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1FA3E635" Offset="0"/><GradientStop Color="#00A3E635" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#103F6212" Offset="0"/><GradientStop Color="#003F6212" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59A3E635" Offset="0"/>
        <GradientStop Color="#2E84CC16" Offset="0.5"/>
        <GradientStop Color="#4D3F6212" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#993F6212" Offset="0"/>
        <GradientStop Color="#7384CC16" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00A3E635" Offset="0"/>
        <GradientStop Color="#99A3E635" Offset="0.3"/>
        <GradientStop Color="#9984CC16" Offset="0.7"/>
        <GradientStop Color="#0084CC16" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#663F6212"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#103F6212"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#243F6212"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1C3F6212"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#17A3E635"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1C84CC16"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#803F6212"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2EA3E635" Offset="0"/>
        <GradientStop Color="#1284CC16" Offset="0.6"/>
        <GradientStop Color="#0084CC16" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#0A0B10"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BEF264" Offset="0"/>
        <GradientStop Color="#A3E635" Offset="0.5"/>
        <GradientStop Color="#84CC16" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3F6212" Offset="0"/>
        <GradientStop Color="#84CC16" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1D25" Offset="0"/>
        <GradientStop Color="#3F6212" Offset="0.6"/>
        <GradientStop Color="#3F6212" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9F4F5F8" Offset="0.55"/>
        <GradientStop Color="#1FA3E635" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#3F6212" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.16"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#A3E635" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#3F6212" BlurRadius="8" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#40A3E635"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#66A3E635"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#5984CC16"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#A3E635"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DA3E635" Offset="0"/><GradientStop Color="#00A3E635" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#4084CC16" Offset="0"/><GradientStop Color="#0084CC16" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
