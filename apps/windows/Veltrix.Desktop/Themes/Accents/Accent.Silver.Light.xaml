<!-- Accent "Silver" for the Light theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#2E3340</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#2E3340"/>
    <Color x:Key="Color.primaryButton">#2E3340</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#2E3340"/>
    <Color x:Key="Color.accent">#2E3340</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#2E3340"/>
    <Color x:Key="Color.violet">#1A1D25</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#1A1D25"/>
    <Color x:Key="Color.focus">#2E3340</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#2E3340"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6F7FA" Offset="0"/><GradientStop Color="#ECEEF3" Offset="0.5"/><GradientStop Color="#E3E6ED" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1F2E3340" Offset="0"/><GradientStop Color="#002E3340" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#102E3340" Offset="0"/><GradientStop Color="#002E3340" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#592E3340" Offset="0"/>
        <GradientStop Color="#2E1A1D25" Offset="0.5"/>
        <GradientStop Color="#4D2E3340" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#992E3340" Offset="0"/>
        <GradientStop Color="#731A1D25" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#002E3340" Offset="0"/>
        <GradientStop Color="#992E3340" Offset="0.3"/>
        <GradientStop Color="#991A1D25" Offset="0.7"/>
        <GradientStop Color="#001A1D25" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#662E3340"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#102E3340"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#242E3340"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1C2E3340"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#172E3340"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1C1A1D25"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#802E3340"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E2E3340" Offset="0"/>
        <GradientStop Color="#121A1D25" Offset="0.6"/>
        <GradientStop Color="#001A1D25" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A5060" Offset="0"/>
        <GradientStop Color="#2E3340" Offset="0.5"/>
        <GradientStop Color="#1A1D25" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E3340" Offset="0"/>
        <GradientStop Color="#1A1D25" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1D25" Offset="0"/>
        <GradientStop Color="#2E3340" Offset="0.6"/>
        <GradientStop Color="#2E3340" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9F4F5F8" Offset="0.55"/>
        <GradientStop Color="#1F2E3340" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#2E3340" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.16"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#2E3340" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#2E3340" BlurRadius="8" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#40E6E9F0"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#66E6E9F0"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#598A90A0"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#E6E9F0"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DC8CDD8" Offset="0"/><GradientStop Color="#00C8CDD8" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#408A90A0" Offset="0"/><GradientStop Color="#008A90A0" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
