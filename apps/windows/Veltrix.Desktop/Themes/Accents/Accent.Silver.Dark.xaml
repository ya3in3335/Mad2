<!-- Accent "Silver" for the Dark theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#E6E9F0</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#E6E9F0"/>
    <Color x:Key="Color.primaryButton">#C8CDD8</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#C8CDD8"/>
    <Color x:Key="Color.accent">#E6E9F0</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#E6E9F0"/>
    <Color x:Key="Color.violet">#8A90A0</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#8A90A0"/>
    <Color x:Key="Color.focus">#E6E9F0</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#E6E9F0"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#26C8CDD8" Offset="0"/><GradientStop Color="#00C8CDD8" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#228A90A0" Offset="0"/><GradientStop Color="#008A90A0" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66F2F4F8" Offset="0"/>
        <GradientStop Color="#2EC8CDD8" Offset="0.5"/>
        <GradientStop Color="#558A90A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99F2F4F8" Offset="0"/>
        <GradientStop Color="#668A90A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00F2F4F8" Offset="0"/>
        <GradientStop Color="#B3F2F4F8" Offset="0.3"/>
        <GradientStop Color="#B38A90A0" Offset="0.7"/>
        <GradientStop Color="#008A90A0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#73E6E9F0"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#14E6E9F0"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#2EE6E9F0"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#24E6E9F0"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1FC8CDD8"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#268A90A0"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#80E6E9F0"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#38C8CDD8" Offset="0"/>
        <GradientStop Color="#148A90A0" Offset="0.6"/>
        <GradientStop Color="#008A90A0" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#0A0B10"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2F4F8" Offset="0"/>
        <GradientStop Color="#C8CDD8" Offset="0.5"/>
        <GradientStop Color="#8A90A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F4F8" Offset="0"/>
        <GradientStop Color="#8A90A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E6E9F0" Offset="0.55"/>
        <GradientStop Color="#F2F4F8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EC8CDD8" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#248A90A0" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#C8CDD8" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#C8CDD8" BlurRadius="20" ShadowDepth="0" Direction="270" Opacity="0.65"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#E6E9F0" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#40E6E9F0"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#66E6E9F0"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#598A90A0"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#E6E9F0"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DC8CDD8" Offset="0"/><GradientStop Color="#00C8CDD8" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#408A90A0" Offset="0"/><GradientStop Color="#008A90A0" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
