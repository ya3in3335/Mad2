<!-- Accent "Teal" for the Dark theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#2DD4BF</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#2DD4BF"/>
    <Color x:Key="Color.primaryButton">#2DD4BF</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#2DD4BF"/>
    <Color x:Key="Color.accent">#2DD4BF</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#2DD4BF"/>
    <Color x:Key="Color.violet">#14B8A6</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#14B8A6"/>
    <Color x:Key="Color.focus">#2DD4BF</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#2DD4BF"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#262DD4BF" Offset="0"/><GradientStop Color="#002DD4BF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#2214B8A6" Offset="0"/><GradientStop Color="#0014B8A6" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#665EEAD4" Offset="0"/>
        <GradientStop Color="#2E2DD4BF" Offset="0.5"/>
        <GradientStop Color="#5514B8A6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#995EEAD4" Offset="0"/>
        <GradientStop Color="#6614B8A6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#005EEAD4" Offset="0"/>
        <GradientStop Color="#B35EEAD4" Offset="0.3"/>
        <GradientStop Color="#B314B8A6" Offset="0.7"/>
        <GradientStop Color="#0014B8A6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#732DD4BF"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#142DD4BF"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#2E2DD4BF"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#242DD4BF"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1F2DD4BF"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#2614B8A6"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#802DD4BF"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#382DD4BF" Offset="0"/>
        <GradientStop Color="#1414B8A6" Offset="0.6"/>
        <GradientStop Color="#0014B8A6" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#0A0B10"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5EEAD4" Offset="0"/>
        <GradientStop Color="#2DD4BF" Offset="0.5"/>
        <GradientStop Color="#14B8A6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5EEAD4" Offset="0"/>
        <GradientStop Color="#14B8A6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#2DD4BF" Offset="0.55"/>
        <GradientStop Color="#5EEAD4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E2DD4BF" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#2414B8A6" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#2DD4BF" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#2DD4BF" BlurRadius="20" ShadowDepth="0" Direction="270" Opacity="0.65"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#2DD4BF" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#402DD4BF"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#662DD4BF"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#5914B8A6"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#2DD4BF"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4D2DD4BF" Offset="0"/><GradientStop Color="#002DD4BF" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#4014B8A6" Offset="0"/><GradientStop Color="#0014B8A6" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
