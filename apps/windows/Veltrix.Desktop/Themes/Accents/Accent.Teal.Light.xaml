<!-- Accent "Teal" for the Light theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#0F766E</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#0F766E"/>
    <Color x:Key="Color.primaryButton">#115E59</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#115E59"/>
    <Color x:Key="Color.accent">#0F766E</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#0F766E"/>
    <Color x:Key="Color.violet">#134E4A</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#134E4A"/>
    <Color x:Key="Color.focus">#0F766E</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#0F766E"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6F7FA" Offset="0"/><GradientStop Color="#ECEEF3" Offset="0.5"/><GradientStop Color="#E3E6ED" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1F115E59" Offset="0"/><GradientStop Color="#00115E59" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#100F766E" Offset="0"/><GradientStop Color="#000F766E" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59115E59" Offset="0"/>
        <GradientStop Color="#2E134E4A" Offset="0.5"/>
        <GradientStop Color="#4D0F766E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#990F766E" Offset="0"/>
        <GradientStop Color="#73134E4A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00115E59" Offset="0"/>
        <GradientStop Color="#99115E59" Offset="0.3"/>
        <GradientStop Color="#99134E4A" Offset="0.7"/>
        <GradientStop Color="#00134E4A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#660F766E"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#100F766E"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#240F766E"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1C0F766E"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#17115E59"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1C134E4A"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#800F766E"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E115E59" Offset="0"/>
        <GradientStop Color="#12134E4A" Offset="0.6"/>
        <GradientStop Color="#00134E4A" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F766E" Offset="0"/>
        <GradientStop Color="#115E59" Offset="0.5"/>
        <GradientStop Color="#134E4A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F766E" Offset="0"/>
        <GradientStop Color="#134E4A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1D25" Offset="0"/>
        <GradientStop Color="#0F766E" Offset="0.6"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9F4F5F8" Offset="0.55"/>
        <GradientStop Color="#1F115E59" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#0F766E" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.16"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#115E59" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#0F766E" BlurRadius="8" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#402DD4BF"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#662DD4BF"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#5914B8A6"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#2DD4BF"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4D2DD4BF" Offset="0"/><GradientStop Color="#002DD4BF" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#4014B8A6" Offset="0"/><GradientStop Color="#0014B8A6" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
