<!-- Accent "Magenta" for the Light theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#A21CAF</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#A21CAF"/>
    <Color x:Key="Color.primaryButton">#A21CAF</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#A21CAF"/>
    <Color x:Key="Color.accent">#A21CAF</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#A21CAF"/>
    <Color x:Key="Color.violet">#86198F</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#86198F"/>
    <Color x:Key="Color.focus">#A21CAF</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#A21CAF"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6F7FA" Offset="0"/><GradientStop Color="#ECEEF3" Offset="0.5"/><GradientStop Color="#E3E6ED" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1FA21CAF" Offset="0"/><GradientStop Color="#00A21CAF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#10A21CAF" Offset="0"/><GradientStop Color="#00A21CAF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59A21CAF" Offset="0"/>
        <GradientStop Color="#2E86198F" Offset="0.5"/>
        <GradientStop Color="#4DA21CAF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99A21CAF" Offset="0"/>
        <GradientStop Color="#7386198F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00A21CAF" Offset="0"/>
        <GradientStop Color="#99A21CAF" Offset="0.3"/>
        <GradientStop Color="#9986198F" Offset="0.7"/>
        <GradientStop Color="#0086198F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#66A21CAF"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#10A21CAF"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#24A21CAF"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1CA21CAF"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#17A21CAF"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1C86198F"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#80A21CAF"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2EA21CAF" Offset="0"/>
        <GradientStop Color="#1286198F" Offset="0.6"/>
        <GradientStop Color="#0086198F" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C026D3" Offset="0"/>
        <GradientStop Color="#A21CAF" Offset="0.5"/>
        <GradientStop Color="#86198F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A21CAF" Offset="0"/>
        <GradientStop Color="#86198F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1D25" Offset="0"/>
        <GradientStop Color="#A21CAF" Offset="0.6"/>
        <GradientStop Color="#A21CAF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9F4F5F8" Offset="0.55"/>
        <GradientStop Color="#1FA21CAF" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#A21CAF" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.16"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#A21CAF" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#A21CAF" BlurRadius="8" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#40E879F9"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#66E879F9"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#5986198F"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#E879F9"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4DA21CAF" Offset="0"/><GradientStop Color="#00A21CAF" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#4086198F" Offset="0"/><GradientStop Color="#0086198F" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
