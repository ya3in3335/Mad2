<!-- Accent "Cyan" for the Light theme. Generated by Themes/Accents/gen-accents.py (edit the palette there and re-run); keep the key set identical across every Accent.*.xaml.
     Merged after Colors.*/Theme.* so these keys override them; swapped at runtime by WpfPlatformUi.ApplyAccent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.primary">#0E7490</Color>
    <SolidColorBrush x:Key="Brush.primary" Color="#0E7490"/>
    <Color x:Key="Color.primaryButton">#155E75</Color>
    <SolidColorBrush x:Key="Brush.primaryButton" Color="#155E75"/>
    <Color x:Key="Color.accent">#0E7490</Color>
    <SolidColorBrush x:Key="Brush.accent" Color="#0E7490"/>
    <Color x:Key="Color.violet">#164E63</Color>
    <SolidColorBrush x:Key="Brush.violet" Color="#164E63"/>
    <Color x:Key="Color.focus">#0E7490</Color>
    <SolidColorBrush x:Key="Brush.focus" Color="#0E7490"/>
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6F7FA" Offset="0"/><GradientStop Color="#ECEEF3" Offset="0.5"/><GradientStop Color="#E3E6ED" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1F155E75" Offset="0"/><GradientStop Color="#00155E75" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#100E7490" Offset="0"/><GradientStop Color="#000E7490" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59155E75" Offset="0"/>
        <GradientStop Color="#2E164E63" Offset="0.5"/>
        <GradientStop Color="#4D0E7490" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#990E7490" Offset="0"/>
        <GradientStop Color="#73164E63" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00155E75" Offset="0"/>
        <GradientStop Color="#99155E75" Offset="0.3"/>
        <GradientStop Color="#99164E63" Offset="0.7"/>
        <GradientStop Color="#00164E63" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#660E7490"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#100E7490"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#240E7490"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1C0E7490"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#17155E75"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1C164E63"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#800E7490"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E155E75" Offset="0"/>
        <GradientStop Color="#12164E63" Offset="0.6"/>
        <GradientStop Color="#00164E63" Offset="1"/>
    </LinearGradientBrush>
    <!-- On-accent text: >= 4.5:1 against every primaryGradient stop (checked by AccentThemeTests). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E7490" Offset="0"/>
        <GradientStop Color="#155E75" Offset="0.5"/>
        <GradientStop Color="#164E63" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E7490" Offset="0"/>
        <GradientStop Color="#164E63" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1D25" Offset="0"/>
        <GradientStop Color="#0E7490" Offset="0.6"/>
        <GradientStop Color="#0E7490" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9F4F5F8" Offset="0.55"/>
        <GradientStop Color="#1F155E75" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Shadow.Card" Color="#0E7490" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.16"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#155E75" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.45"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#0E7490" BlurRadius="8" ShadowDepth="0" Direction="270" Opacity="0.5"/>
    <!-- Splash screen (always on a dark canvas): dark-palette colours in both theme variants. -->
    <SolidColorBrush x:Key="Splash.border" Color="#4022D3EE"/>
    <SolidColorBrush x:Key="Splash.ring" Color="#6622D3EE"/>
    <SolidColorBrush x:Key="Splash.ringInner" Color="#5906B6D4"/>
    <SolidColorBrush x:Key="Splash.pulse" Color="#22D3EE"/>
    <RadialGradientBrush x:Key="Splash.glowA"><GradientStop Color="#4D22D3EE" Offset="0"/><GradientStop Color="#0022D3EE" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Splash.glowB"><GradientStop Color="#4006B6D4" Offset="0"/><GradientStop Color="#0006B6D4" Offset="1"/></RadialGradientBrush>
</ResourceDictionary>
