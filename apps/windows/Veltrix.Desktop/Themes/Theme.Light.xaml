<!-- Hand-written companion to the generated Colors.Light.xaml: derived surfaces, gradients and elevation for the light theme.
     Swapped together with Colors.*.xaml by WpfPlatformUi.ApplyTheme. Keep the key set identical to Theme.Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.surfaceHover" Color="#E8EFFB"/>
    <SolidColorBrush x:Key="Brush.surfaceSunken" Color="#FAFBFE"/>
    <SolidColorBrush x:Key="Brush.borderStrong" Color="#B6C4DA"/>
    <SolidColorBrush x:Key="Brush.topbar" Color="#F2FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.sidebar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F7F9FE" Offset="0.7"/>
        <GradientStop Color="#F1F0FE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FBFCFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="0.25,1">
        <GradientStop Color="#702563EB" Offset="0"/>
        <GradientStop Color="#D3DDEC" Offset="0.12"/>
        <GradientStop Color="#D5DEEC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#002563EB" Offset="0"/>
        <GradientStop Color="#B32563EB" Offset="0.3"/>
        <GradientStop Color="#B30091B3" Offset="0.7"/>
        <GradientStop Color="#006447F0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Interaction overlays and tints -->
    <SolidColorBrush x:Key="Brush.overlayHover" Color="#0C07111F"/>
    <SolidColorBrush x:Key="Brush.overlayPress" Color="#1A07111F"/>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#472563EB"/>
    <SolidColorBrush x:Key="Brush.rowAlt" Color="#F7F9FD"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#EDF2FC"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#242563EB"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#1A2563EB"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#170091B3"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#1A6447F0"/>
    <SolidColorBrush x:Key="Brush.successSoft" Color="#1A0E8F63"/>
    <SolidColorBrush x:Key="Brush.warningSoft" Color="#1AA86400"/>
    <SolidColorBrush x:Key="Brush.dangerSoft" Color="#14C9354A"/>
    <SolidColorBrush x:Key="Brush.dangerBorder" Color="#80C9354A"/>
    <SolidColorBrush x:Key="Brush.scrollThumb" Color="#C2CDDE"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#93A4BF"/>
    <SolidColorBrush x:Key="Brush.chip" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.chipBorder" Color="#C9D5E7"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#262563EB" Offset="0"/>
        <GradientStop Color="#080091B3" Offset="1"/>
    </LinearGradientBrush>

    <!-- Brand gradients -->
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#2B74F0" Offset="0.55"/>
        <GradientStop Color="#0A8FC4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#0091B3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1D4FD8" Offset="0"/>
        <GradientStop Color="#007C99" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EAF1FF" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="0.6"/>
        <GradientStop Color="#F0EDFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Elevation -->
    <DropShadowEffect x:Key="Shadow.Card" Color="#1B2A4A" BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.10"/>
    <DropShadowEffect x:Key="Shadow.Popup" Color="#1B2A4A" BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.18"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#2563EB" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.30"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#2563EB" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
</ResourceDictionary>
