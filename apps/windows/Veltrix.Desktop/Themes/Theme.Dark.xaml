<!-- Glass Neon (silver) companion to Colors.Dark.xaml: dark (near-black canvas, white glass, silver neon edges).
     Swapped together with Colors.*.xaml by WpfPlatformUi.ApplyTheme. Keep the key set identical to Theme.Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window backdrop: static (non-animated) radial glows behind all content. -->
    <DrawingBrush x:Key="Brush.backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><SolidColorBrush Color="#07080B"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#1CE6E9F0" Offset="0"/><GradientStop Color="#00E6E9F0" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.65" RadiusY="0.65"><GradientStop Color="#1A8A90A0" Offset="0"/><GradientStop Color="#008A90A0" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry><GeometryDrawing.Brush><RadialGradientBrush Center="0.6,0.45" GradientOrigin="0.6,0.45" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#0AFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Glass surfaces -->
    <SolidColorBrush x:Key="Brush.surfaceHover" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Brush.surfaceSunken" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.borderStrong" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.topbar" Color="#B30A0B0E"/>
    <SolidColorBrush x:Key="Brush.glass" Color="#17FFFFFF"/>
    <LinearGradientBrush x:Key="Brush.sidebar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A60D0E12" Offset="0"/>
        <GradientStop Color="#990A0B0E" Offset="0.65"/>
        <GradientStop Color="#A6121419" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1FFFFFFF" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- 1 px neon edge: silver → gray at ~35 % -->
    <LinearGradientBrush x:Key="Brush.cardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5CE6E9F0" Offset="0"/>
        <GradientStop Color="#2EC8CDD8" Offset="0.5"/>
        <GradientStop Color="#4D8A90A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ghostBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8CE6E9F0" Offset="0"/>
        <GradientStop Color="#598A90A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E6E9F0" Offset="0"/>
        <GradientStop Color="#B3E6E9F0" Offset="0.3"/>
        <GradientStop Color="#B38A90A0" Offset="0.7"/>
        <GradientStop Color="#008A90A0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Interaction overlays and tints -->
    <SolidColorBrush x:Key="Brush.overlayHover" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Brush.overlayPress" Color="#40000000"/>
    <SolidColorBrush x:Key="Brush.focusRing" Color="#66E6E9F0"/>
    <SolidColorBrush x:Key="Brush.rowAlt" Color="#06FFFFFF"/>
    <SolidColorBrush x:Key="Brush.rowHover" Color="#14E6E9F0"/>
    <SolidColorBrush x:Key="Brush.selection" Color="#24E6E9F0"/>
    <SolidColorBrush x:Key="Brush.primarySoft" Color="#22E6E9F0"/>
    <SolidColorBrush x:Key="Brush.accentSoft" Color="#1CC8CDD8"/>
    <SolidColorBrush x:Key="Brush.violetSoft" Color="#268A90A0"/>
    <SolidColorBrush x:Key="Brush.successSoft" Color="#1F4CC38A"/>
    <SolidColorBrush x:Key="Brush.warningSoft" Color="#1FE0B04A"/>
    <SolidColorBrush x:Key="Brush.dangerSoft" Color="#1FFF8095"/>
    <SolidColorBrush x:Key="Brush.dangerBorder" Color="#80FF8095"/>
    <SolidColorBrush x:Key="Brush.scrollThumb" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Brush.scrollThumbHover" Color="#80E6E9F0"/>
    <SolidColorBrush x:Key="Brush.chip" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Brush.chipBorder" Color="#2EFFFFFF"/>
    <LinearGradientBrush x:Key="Brush.navActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#33E6E9F0" Offset="0"/>
        <GradientStop Color="#148A90A0" Offset="0.6"/>
        <GradientStop Color="#008A90A0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Neon gradients. Text on primaryGradient uses Brush.onPrimary (>= 6:1 on every stop). -->
    <SolidColorBrush x:Key="Brush.onPrimary" Color="#0A0B10"/>
    <LinearGradientBrush x:Key="Brush.primaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2F4F8" Offset="0"/>
        <GradientStop Color="#C8CDD8" Offset="0.5"/>
        <GradientStop Color="#8A90A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.accentBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#8A90A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.textGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E6E9F0" Offset="0.5"/>
        <GradientStop Color="#A9AFBD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.totalPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24E6E9F0" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#1A8A90A0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glow / elevation (only on child-less backing elements so text keeps ClearType; never on rows or list items) -->
    <DropShadowEffect x:Key="Shadow.Card" Color="#E6E9F0" BlurRadius="16" ShadowDepth="0" Direction="270" Opacity="0.55"/>
    <DropShadowEffect x:Key="Shadow.Popup" Color="#000000" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.6"/>
    <DropShadowEffect x:Key="Shadow.Primary" Color="#FFFFFF" BlurRadius="18" ShadowDepth="0" Direction="270" Opacity="0.55"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#E6E9F0" BlurRadius="12" ShadowDepth="0" Direction="270" Opacity="0.9"/>
</ResourceDictionary>
