# Copy to .env.local for development. No secrets belong in this file.

# Base URL of the VELTRIX ASP.NET API. Read server-side only (never sent to the browser).
# Optional at build time (`npm run build` does not contact the API); required at runtime.
VELTRIX_API_URL=http://localhost:5080

# development | production. In production, session cookies are Secure and use the __Host- prefix,
# so the Control Center must be served over HTTPS.
NODE_ENV=development

# Disable Next.js anonymous telemetry (optional).
NEXT_TELEMETRY_DISABLED=1
