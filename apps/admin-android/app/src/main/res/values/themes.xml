<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VeltrixAdmin" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/veltrix_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/veltrix_navy</item>
    </style>
    <!-- System splash: navy plate + approved VELTRIX emblem. -->
    <style name="Theme.VeltrixAdmin.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/veltrix_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VeltrixAdmin</item>
    </style>
</resources>
