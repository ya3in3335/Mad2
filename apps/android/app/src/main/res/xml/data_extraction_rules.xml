<?xml version="1.0" encoding="utf-8"?>
<!-- Anti-copy: the device binding, Keystore-protected secrets and the local business database must never be backed up or
     transferred to another device. Everything is excluded from cloud backup and device-to-device transfer (allowBackup is
     also false in the manifest). Users move data only through the app's own password-encrypted backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
        <exclude domain="device_root" /><exclude domain="device_file" /><exclude domain="device_database" /><exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
        <exclude domain="device_root" /><exclude domain="device_file" /><exclude domain="device_database" /><exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
