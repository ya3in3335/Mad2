<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Veltrix" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/veltrix_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/veltrix_navy</item>
    </style>
    <!-- System splash shows the plain navy plate + emblem; the animated brand sequence runs in Compose. -->
    <style name="Theme.Veltrix.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/veltrix_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Veltrix</item>
    </style>
</resources>
